<Project>
  <Target Name="LegatoMappingExtensionsSources" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="LegatoConfigure">
    <PropertyGroup Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.39.0')) AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.40.0'))">
      <DefineConstants>$(DefineConstants);LEGATO_ABSOLUTE_LEGACY_ROTATION</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
      <Compile Remove="HarmonyPatches\ExtraLanesAndLayersPatches.cs;HarmonyPatches\360DegreeNoteRotationPatches.cs;HarmonyPatches\AdditionalWallAdjustementsPatches.cs;HarmonyPatches\PrecisePlacementPatches.cs" />
      <Compile Include="$(LegatoSourceRoot)Providers\MappingExtensions\**\*.cs" />
    </ItemGroup>
  </Target>
</Project>
