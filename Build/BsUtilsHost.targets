<Project>
  <Target Name="LegatoBsUtilsNativeReferences" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="LegatoConfigure">
    <PropertyGroup Condition="'$(LegatoTargetVersion)' == '0.11.1' OR '$(LegatoTargetVersion)' == '0.11.2'">
      <DefineConstants>$(DefineConstants);LEGATO_BSUTILS_EARLY;LEGATO_BEFORE_MULTIPLAYER</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(LegatoTargetVersion)' == '0.11.2'">
      <DefineConstants>$(DefineConstants);LEGATO_BSUTILS_EARLY_SCENE_LIST</DefineConstants>
    </PropertyGroup>
    <ItemGroup Condition="'$(LegatoTargetVersion)' == '0.11.1' OR '$(LegatoTargetVersion)' == '0.11.2'">
      <Reference Remove="BGLib.AppFlow;BGLib.UnityExtension;BGNetCore;BeatSaber.Init;BeatmapCore;BeatSaber.Multiplayer.Core;BeatSaber.ViewSystem;DataModels;GamePlayCore;HMLib;HMUI;Main;PlatformUserModel;OculusStudios.Platform.Core;OculusStudios.Platform.Steam;com.rlabrecque.steamworks.net;Unity.TextMeshPro;Zenject;Zenject-usage" />
      <Reference Include="Assembly-CSharp" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Assembly-CSharp.dll" Private="false" />
      <Reference Include="Assembly-CSharp-firstpass" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Assembly-CSharp-firstpass.dll" Private="false" />
      <Reference Include="UnityEngine" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\UnityEngine.dll" Private="false" />
      <Reference Include="UnityEngine.UIModule" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\UnityEngine.UIModule.dll" Private="false" />
      <Reference Include="UnityEngine.UI" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\UnityEngine.UI.dll" Private="false" />
      <Reference Include="TextMeshPro-1.0.55.2017.1.0b12" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\TextMeshPro-1.0.55.2017.1.0b12.dll" Private="false" />
    </ItemGroup>
    <ItemGroup Condition="'$(LegatoTargetProfile)' == '1.29.0'">
      <Reference Remove="BGLib.AppFlow;BGLib.UnityExtension;BGNetCore;BeatSaber.Init;BeatSaber.Multiplayer.Core;BeatSaber.ViewSystem;DataModels;PlatformUserModel;OculusStudios.Platform.Core;OculusStudios.Platform.Steam;com.rlabrecque.steamworks.net" />
      <Reference Include="BGNet" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGNet.dll" Private="false" />
    </ItemGroup>
    <ItemGroup Condition="Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Steamworks.NET.dll')">
      <Reference Remove="com.rlabrecque.steamworks.net" />
      <Reference Include="Steamworks.NET" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Steamworks.NET.dll" Private="false" />
    </ItemGroup>
    <ItemGroup>
      <Reference Remove="BeatSaber.Multiplayer.Core" Condition="!Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BeatSaber.Multiplayer.Core.dll')" />
      <Reference Remove="BeatSaber.ViewSystem" Condition="!Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BeatSaber.ViewSystem.dll')" />
      <Reference Remove="OculusStudios.Platform.Core" Condition="!Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\OculusStudios.Platform.Core.dll')" />
      <Reference Remove="OculusStudios.Platform.Steam" Condition="!Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\OculusStudios.Platform.Steam.dll')" />
      <Reference Include="Interactable" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Interactable.dll" Private="false"
                 Condition="Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Interactable.dll') AND '@(Reference->WithMetadataValue('Identity', 'Interactable'))' == ''" />
    </ItemGroup>
  </Target>
</Project>
