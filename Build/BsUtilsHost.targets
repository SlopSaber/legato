<Project>
  <Target Name="LegatoBsUtilsNativeReferences" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="LegatoConfigure">
    <ItemGroup Condition="'$(LegatoTargetProfile)' == '1.29.0'">
      <Reference Remove="BGLib.AppFlow;BGLib.UnityExtension;BGNetCore;BeatSaber.Init;BeatSaber.Multiplayer.Core;BeatSaber.ViewSystem;DataModels;PlatformUserModel;OculusStudios.Platform.Core;OculusStudios.Platform.Steam;com.rlabrecque.steamworks.net" />
      <Reference Include="BGNet" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGNet.dll" Private="false" />
    </ItemGroup>
    <ItemGroup Condition="Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Steamworks.NET.dll')">
      <Reference Remove="com.rlabrecque.steamworks.net" />
      <Reference Include="Steamworks.NET" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Steamworks.NET.dll" Private="false" />
    </ItemGroup>
    <ItemGroup>
      <Reference Remove="BeatSaber.Multiplayer.Core" Condition="!Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BeatSaber.Multiplayer.Core.dll')" />
      <Reference Remove="BeatSaber.ViewSystem" Condition="!Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BeatSaber.ViewSystem.dll')" />
      <Reference Remove="OculusStudios.Platform.Core" Condition="!Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\OculusStudios.Platform.Core.dll')" />
      <Reference Remove="OculusStudios.Platform.Steam" Condition="!Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\OculusStudios.Platform.Steam.dll')" />
      <Reference Include="Interactable" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Interactable.dll" Private="false"
                 Condition="Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Interactable.dll') AND '@(Reference->WithMetadataValue('Identity', 'Interactable'))' == ''" />
    </ItemGroup>
  </Target>
</Project>
