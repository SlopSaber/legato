<Project>
  <Target Name="LegatoLegacyTypeReferences" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="LegatoConfigure">
    <ItemGroup>
      <Reference Remove="BGLib.Polyglot" Condition="'$(LegatoEnableLocalizationAliases)' == 'true' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Polyglot.dll')" />
      <Reference Include="Polyglot" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Polyglot.dll" Private="false"
                 Condition="'$(LegatoEnableLocalizationAliases)' == 'true' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Polyglot.dll') AND '@(Reference->WithMetadataValue('Identity', 'Polyglot'))' == ''" />
      <Reference Include="Main" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Main.dll" Private="false"
                 Condition="'$(LegatoEnableNativeTypeAliases)' == 'true' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Main.dll') AND '@(Reference->WithMetadataValue('Identity', 'Main'))' == ''" />
      <Reference Include="HMLib" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\HMLib.dll" Private="false"
                 Condition="'$(LegatoEnableNativeTypeAliases)' == 'true' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\HMLib.dll') AND '@(Reference->WithMetadataValue('Identity', 'HMLib'))' == ''" />
      <Reference Include="Unity.TextMeshPro" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Unity.TextMeshPro.dll" Private="false"
                 Condition="'$(LegatoEnableBSML)' == 'true' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Unity.TextMeshPro.dll') AND '@(Reference->WithMetadataValue('Identity', 'Unity.TextMeshPro'))' == ''" />
    </ItemGroup>
    <ItemGroup Condition="'$(LegatoTargetProfile)' == '1.29.0'">
      <Reference Remove="BeatSaber.Haptics;AdditionalContentModel.Interfaces;DataModels;BGLib.AppFlow;BeatSaber.Init;BeatSaber.ViewSystem;GameInit;Menu.ColorSettings;Menu.CommonLib;BGLib.UnityExtension;Unity.RenderPipelines.Core.Runtime;Unity.RenderPipelines.Universal.Runtime;Unity.XR.Management;Unity.XR.OpenXR" />
      <Reference Remove="@(Reference)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Reference.Identity)', '^(?:BeatSaber\.(?:ViewSystem|GameSettings|Settings|Haptics|Init)|GameInit|AdditionalContentModel\.Interfaces|DataModels|BGLib\.(?:AppFlow|UnityExtension|FileStorage|SaveDataCore)|VRUI\.Interfaces)(?:,|$)'))" />
    </ItemGroup>
    <ItemGroup Condition="'$(LegatoEnableBSML)' == 'true' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\UnityEngine.ImageConversionModule.dll') AND '@(Reference->WithMetadataValue('Identity', 'UnityEngine.ImageConversionModule'))' == ''">
      <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\UnityEngine.ImageConversionModule.dll" Private="false" />
    </ItemGroup>
  </Target>
</Project>
