<Project>
  <Target Name="LegatoLegacyTypeReferences" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="LegatoConfigure">
    <ItemGroup>
      <Reference Include="HMUI" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\HMUI.dll" Private="false"
                 Condition="'$(LegatoTargetProfile)' == '1.29.0' AND '$(LegatoEnableNativeTypeAliases)' == 'true' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\HMUI.dll') AND '@(Reference->WithMetadataValue('Identity', 'HMUI'))' == ''" />
      <Reference Include="UnityEngine.VRModule" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\UnityEngine.VRModule.dll" Private="false"
                 Condition="'$(LegatoEnableUnityCompatibility)' == 'true' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\UnityEngine.VRModule.dll') AND '@(Reference->WithMetadataValue('Identity', 'UnityEngine.VRModule'))' == ''" />
      <Reference Remove="BGLib.Polyglot" Condition="'$(LegatoEnableLocalizationAliases)' == 'true' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Polyglot.dll')" />
      <Reference Include="Polyglot" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Polyglot.dll" Private="false" Publicize="true"
                 Condition="'$(LegatoEnableLocalizationAliases)' == 'true' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Polyglot.dll') AND '@(Reference->WithMetadataValue('Identity', 'Polyglot'))' == ''" />
      <Reference Include="Main" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Main.dll" Private="false"
                 Condition="'$(LegatoEnableNativeTypeAliases)' == 'true' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Main.dll') AND '@(Reference->WithMetadataValue('Identity', 'Main'))' == ''" />
      <Reference Include="HMLib" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\HMLib.dll" Private="false"
                 Condition="'$(LegatoEnableNativeTypeAliases)' == 'true' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\HMLib.dll') AND '@(Reference->WithMetadataValue('Identity', 'HMLib'))' == ''" />
      <Reference Include="Unity.TextMeshPro" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Unity.TextMeshPro.dll" Private="false"
                 Condition="'$(LegatoEnableBSML)' == 'true' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Unity.TextMeshPro.dll') AND '@(Reference->WithMetadataValue('Identity', 'Unity.TextMeshPro'))' == ''" />
      <Reference Include="UnityEngine.TextCoreModule" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\UnityEngine.TextCoreModule.dll" Private="false"
                 Condition="'$(LegatoEnableFontGlyphs)' == 'true' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\UnityEngine.TextCoreModule.dll') AND '@(Reference->WithMetadataValue('Identity', 'UnityEngine.TextCoreModule'))' == ''" />
      <Reference Remove="UnityEngine.TextCoreFontEngineModule" Condition="'$(LegatoEnableFontGlyphs)' == 'true' AND !Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\UnityEngine.TextCoreFontEngineModule.dll')" />
    </ItemGroup>
    <ItemGroup Condition="'$(LegatoTargetProfile)' == '1.29.0'">
      <Reference Include="Rendering" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Rendering.dll" Private="false" Condition="'$(LegatoEnableNativeGameState)' == 'true' AND '@(Reference->WithMetadataValue('Identity', 'Rendering'))' == ''" />
      <_LegatoLegacyNetworkReference Include="@(Reference->WithMetadataValue('Identity', 'BGNetCore'))" />
      <Reference Remove="BGNetCore" />
      <Reference Include="BGNet" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGNet.dll" Private="false"
                 Condition="'@(_LegatoLegacyNetworkReference)' != '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGNet.dll') AND '@(Reference->WithMetadataValue('Identity', 'BGNet'))' == ''" />
      <Reference Remove="SaberTrail;BeatSaber.Audio.Common;BeatSaber.Multiplayer.Core;MenuSystem;MenuLightPreset;MediaLoader;OculusStudios.Platform.Core;OculusStudios.Platform.Steam;PlatformUserModel;Networking;BeatSaber.Common.Pause;BeatSaber.AvatarCore;BeatSaber.BeatAvatarAdapter;BeatSaber.BeatAvatarSDK;UnityEngine.SpatialTracking;com.rlabrecque.steamworks.net;Tweening;SegmentedControl;BeatSaber.Haptics;AdditionalContentModel.Interfaces;DataModels;BGLib.AppFlow;BeatSaber.Init;BeatSaber.ViewSystem;GameInit;Menu.ColorSettings;Menu.CommonLib;BGLib.UnityExtension;BGLib.DotnetExtension;Unity.RenderPipelines.Core.Runtime;Unity.RenderPipelines.Universal.Runtime;Unity.XR.Management;Unity.XR.OpenXR" />
      <Reference Remove="@(Reference)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Reference.Identity)', '^(?:BeatSaber\.(?:ViewSystem|GameSettings|Settings|Haptics|Init)|GameInit|AdditionalContentModel\.Interfaces|DataModels|BGLib\.(?:AppFlow|UnityExtension|FileStorage|SaveDataCore)|VRUI\.Interfaces)(?:,|$)'))" />
    </ItemGroup>
    <ItemGroup Condition="'$(LegatoEnableBSML)' == 'true' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\UnityEngine.ImageConversionModule.dll') AND '@(Reference->WithMetadataValue('Identity', 'UnityEngine.ImageConversionModule'))' == ''">
      <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\UnityEngine.ImageConversionModule.dll" Private="false" />
    </ItemGroup>
  </Target>
  <Target Name="LegatoEditorReferences" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="LegatoConfigure" Condition="'$(LegatoEnableEditorAccess)' == 'true' AND '$(LegatoTargetProfile)' == '1.29.0'">
    <ItemGroup>
      <Reference Remove="BeatSaber.BeatmapEditor" />
      <Reference Include="BeatmapEditor3D" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BeatmapEditor3D.dll" Publicize="true" Private="false" />
    </ItemGroup>
  </Target>
  <Target Name="LegatoSteamIdentityReferences" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="LegatoLegacyTypeReferences" Condition="'$(LegatoEnableSteamIdentity)' == 'true'">
    <PropertyGroup>
      <_LegatoSteamIdentityAssembly Condition="'$(LegatoTargetProfile)' == '1.29.0'">Steamworks.NET</_LegatoSteamIdentityAssembly>
      <_LegatoSteamIdentityAssembly Condition="'$(LegatoTargetProfile)' != '1.29.0'">com.rlabrecque.steamworks.net</_LegatoSteamIdentityAssembly>
    </PropertyGroup>
    <ItemGroup>
      <Reference Remove="Steamworks.NET;com.rlabrecque.steamworks.net" />
      <Reference Include="$(_LegatoSteamIdentityAssembly)" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\$(_LegatoSteamIdentityAssembly).dll" Private="false" Publicize="$(LegatoEnableSteamAuthentication)" />
    </ItemGroup>
  </Target>
  <Target Name="LegatoResolveLoaderJson" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="$(LegatoJsonLayoutTarget)" Condition="'$(LegatoPreferLoaderJson)' == 'true' AND Exists('$(LegatoReferenceRoot)\IPA\CoreLibraries\Newtonsoft.Json.dll')">
    <ItemGroup>
      <Reference Remove="Newtonsoft.Json" />
      <Reference Include="Newtonsoft.Json" HintPath="$(LegatoReferenceRoot)\IPA\CoreLibraries\Newtonsoft.Json.dll" Private="false" />
    </ItemGroup>
  </Target>
</Project>
