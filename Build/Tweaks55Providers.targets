<Project>
  <Target Name="LegatoTweaks55Sources" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="LegatoConfigure">
    <ItemGroup>
      <Compile Remove="HarmonyPatches\DisableAnalytics.cs;HarmonyPatches\RumbleStuff.cs;HarmonyPatches\OverlayFocus.cs" />
      <Compile Include="$(LegatoSourceRoot)Providers\Tweaks55\**\*.cs" />
      <Reference Remove="BeatGames.Analytics;osce.analytics" Condition="'$(LegatoTargetProfile)' == '1.29.0'" />
    </ItemGroup>
  </Target>
</Project>
