<Project>
  <PropertyGroup Condition="'$(GenerateDocumentationFile)' != 'true' AND ('$(LegatoEnableHeckProviders)' == 'true' OR '$(LegatoEnableChromaProviders)' == 'true' OR '$(LegatoEnableNoodleExtensionsProviders)' == 'true' OR '$(LegatoEnableVivifyProviders)' == 'true')">
    <NoWarn>$(NoWarn);SA0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EditorConfigFiles Include="$(LegatoSourceRoot)Library\LegacyShaderRendering\.editorconfig"
                       Condition="'$(LegatoEnableLegacyShaderRendering)' == 'true'" />
    <EditorConfigFiles Include="$(LegatoSourceRoot)Library\BundleShaderMetadata\.editorconfig"
                       Condition="'$(LegatoEnableBundleShaderMetadata)' == 'true'" />
    <EditorConfigFiles Include="$(LegatoSourceRoot)Providers\Vivify\.editorconfig"
                       Condition="'$(LegatoEnableVivifyProviders)' == 'true'" />
    <EditorConfigFiles Include="$(LegatoSourceRoot)Providers\NoodleExtensions\.editorconfig"
                       Condition="'$(LegatoEnableNoodleExtensionsProviders)' == 'true'" />
    <EditorConfigFiles Include="$(LegatoSourceRoot)Providers\Chroma\.editorconfig"
                       Condition="'$(LegatoEnableChromaProviders)' == 'true'" />
    <EditorConfigFiles Include="$(LegatoSourceRoot)Providers\Heck\.editorconfig"
                       Condition="'$(LegatoEnableHeckProviders)' == 'true'" />
    <EditorConfigFiles Include="$(LegatoSourceRoot)Providers\CustomJSONData\.editorconfig"
                       Condition="'$(LegatoEnableCustomJsonDataProviders)' == 'true'" />
  </ItemGroup>
  <Target Name="LegatoCustomJsonLegacyReferences" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="LegatoConfigure">
    <PropertyGroup Condition="'$(LegatoTargetProfile)' == '1.29.0' AND '$(LegatoEnableCustomJsonDataProviders)' == 'true'">
      <LegatoUseReferencePublicizeMetadata>true</LegatoUseReferencePublicizeMetadata>
    </PropertyGroup>
    <ItemGroup Condition="'$(LegatoTargetProfile)' == '1.29.0' AND '$(LegatoEnableCustomJsonDataProviders)' == 'true'">
      <Reference Remove="AdditionalContentModel.Interfaces;DataModels;Tweening" />
    </ItemGroup>
  </Target>
  <Target Name="LegatoSuiteLegacyReferences" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="LegatoConfigure">
    <ItemGroup Condition="'$(LegatoEnableHeckProviders)' == 'true' OR '$(LegatoEnableChromaProviders)' == 'true' OR '$(LegatoEnableNoodleExtensionsProviders)' == 'true' OR '$(LegatoEnableVivifyProviders)' == 'true'">
      <Reference Remove="BeatSaber.Multiplayer.Core" Condition="!Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BeatSaber.Multiplayer.Core.dll')" />
      <Reference Remove="BeatSaber.Settings" Condition="!Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BeatSaber.Settings.dll')" />
      <Reference Remove="BeatSaber.ViewSystem" Condition="!Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BeatSaber.ViewSystem.dll')" />
      <Reference Remove="BeatSaber.Haptics" Condition="!Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BeatSaber.Haptics.dll')" />
      <Reference Remove="SaberTrail" Condition="!Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\SaberTrail.dll')" />
    </ItemGroup>
    <ItemGroup Condition="'$(LegatoTargetProfile)' == '1.29.0' AND ('$(LegatoEnableHeckProviders)' == 'true' OR '$(LegatoEnableChromaProviders)' == 'true' OR '$(LegatoEnableNoodleExtensionsProviders)' == 'true' OR '$(LegatoEnableVivifyProviders)' == 'true')">
      <Reference Remove="AdditionalContentModel.Interfaces;BGLib.AppFlow;BGLib.DotnetExtension;BGLib.JsonExtension;BGLib.SaveDataCore;BGLib.UnityExtension;BGNetCore;BeatSaber.GameSettings;BeatSaber.Multiplayer.Core;BeatSaber.Settings;BeatSaber.ViewSystem;DataModels;MediaLoader;Tweening" />
    </ItemGroup>
  </Target>
  <Target Name="LegatoVivifyLegacyReferences" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="LegatoConfigure">
    <PropertyGroup Condition="'$(LegatoEnableVivifyProviders)' == 'true'">
      <LegatoUseReferencePublicizeMetadata>true</LegatoUseReferencePublicizeMetadata>
    </PropertyGroup>
    <ItemGroup Condition="'$(LegatoEnableVivifyProviders)' == 'true'">
      <Reference Remove="ZenjectExtension" Condition="!Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\ZenjectExtension.dll')" />
    </ItemGroup>
    <ItemGroup Condition="'$(LegatoTargetProfile)' == '1.29.0' AND '$(LegatoEnableVivifyProviders)' == 'true'">
      <Reference Remove="Unity.XR.OpenXR" />
    </ItemGroup>
    <ItemGroup Condition="'$(LegatoEnableLegacyShaderRendering)' == 'true' AND ('$(LegatoTargetProfile)' == '1.45.1' OR '$(LegatoTargetProfile)' == '1.45.3')">
      <Reference Include="Unity.Collections;Unity.RenderPipelines.Core.Runtime;Unity.RenderPipelines.Core.Runtime.Shared;Unity.RenderPipelines.Universal.Runtime"
                 Exclude="@(Reference)">
        <HintPath>$(LegatoReferenceRoot)\Beat Saber_Data\Managed\%(Identity).dll</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>
  <!-- Keep the suite's original version ordering while selecting it from Legato's target. -->
  <Target Name="LBSM_GetConfigurationInfo" DependsOnTargets="LegatoConfigure">
    <PropertyGroup>
      <_LegatoHeckCodeVersion>$(LegatoTargetVersion)</_LegatoHeckCodeVersion>
      <_LegatoHeckCodeVersion Condition="'$(LegatoTargetProfile)' == '1.29.0'">1.29.1</_LegatoHeckCodeVersion>
      <_LegatoHeckCodeVersion Condition="'$(LegatoTargetProfile)' == '1.40.0' AND '$(LegatoEnableCustomJsonDataProviders)' != 'true' AND $([MSBuild]::VersionLessThanOrEquals('$(_LegatoApiVersion)', '1.40.8'))">1.40.8</_LegatoHeckCodeVersion>
      <_LegatoHeckConfiguration>Release-$(_LegatoHeckCodeVersion)</_LegatoHeckConfiguration>
      <_LegatoHeckConfiguration Condition="$(Configuration.StartsWith('Debug'))">Debug-$(_LegatoHeckCodeVersion)</_LegatoHeckConfiguration>
      <_LegatoHeckConfigurations>$(Configurations)</_LegatoHeckConfigurations>
      <_LegatoHeckConfigurations Condition="!$([System.String]::Copy(';$(Configurations);').Contains(';$(_LegatoHeckConfiguration);'))">$(Configurations);$(_LegatoHeckConfiguration)</_LegatoHeckConfigurations>
    </PropertyGroup>
    <GetConfigurationInfo AllConfigurations="$(_LegatoHeckConfigurations)" Configuration="$(_LegatoHeckConfiguration)">
      <Output TaskParameter="Constants" PropertyName="GeneratedConstants" />
      <Output TaskParameter="GameVersion" PropertyName="GeneratedGameVersion" />
    </GetConfigurationInfo>
    <PropertyGroup>
      <DefineConstants>$([System.Text.RegularExpressions.Regex]::Replace('$(DefineConstants)', '\b(?:(?:PRE_|POST_)?V\d+_\d+_\d+|LATEST|BEAT_SABER_1453|BEAT_SABER_1460)\b', ''));$(GeneratedConstants)</DefineConstants>
      <DefineConstants Condition="$(LegatoTargetOrder) &gt;= 3">$(DefineConstants);LEGATO_BEATMAP_OBJECT_ROTATION</DefineConstants>
      <DefineConstants Condition="$(LegatoTargetOrder) &gt;= 4 OR ($(LegatoTargetOrder) &gt;= 3 AND '$(LegatoEnableHeckProviders)' != 'true')">$(DefineConstants);LATEST</DefineConstants>
      <DefineConstants Condition="$(LegatoTargetOrder) &gt;= 2">$(DefineConstants);LEGATO_BEATMAP_OBJECT_BEAT</DefineConstants>
      <DefineConstants Condition="'$(LegatoTargetProfile)' == '1.45.3'">$(DefineConstants);BEAT_SABER_1453</DefineConstants>
      <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(LegatoTargetVersion)', '1.46.0'))">$(DefineConstants);BEAT_SABER_1460</DefineConstants>
      <GameVersion>$(LegatoTargetVersion)</GameVersion>
    </PropertyGroup>
    <Message Text="Legato Heck profile: $(LegatoTargetVersion); $(GeneratedConstants)" Importance="high" />
  </Target>
</Project>
