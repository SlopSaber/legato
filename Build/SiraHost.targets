<Project>
  <Target Name="LegatoSiraNativeReferences" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="LegatoConfigure">
    <PropertyGroup Condition="!Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BeatSaber.ViewSystem.dll')">
      <DefineConstants>$(DefineConstants);LEGATO_SIRA_LEGACY_VIEW_SYSTEM</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
      <Reference Remove="BeatSaber.ViewSystem" Condition="!Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BeatSaber.ViewSystem.dll')" />
      <Reference Remove="BeatSaber.Multiplayer.Core" Condition="!Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BeatSaber.Multiplayer.Core.dll')" />
      <Reference Remove="GameInit" Condition="!Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\GameInit.dll')" />
      <Reference Remove="SaberTrail" Condition="!Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\SaberTrail.dll')" />
    </ItemGroup>
    <ItemGroup Condition="'$(LegatoTargetProfile)' == '1.29.0'">
      <Reference Remove="BGLib.AppFlow;BGLib.DotnetExtension;BGLib.Polyglot;BGLib.UnityExtension;BGNetCore;BeatSaber.Init;DataModels;Unity.InputSystem;Unity.XR.Management;Unity.XR.OpenXR;UnityEngine.SpatialTracking" />
      <Reference Include="Polyglot" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Polyglot.dll" Private="false" />
      <Reference Include="BGNet" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGNet.dll" Private="false" />
    </ItemGroup>
    <PropertyGroup Condition="'$(LegatoTargetVersion)' == '0.11.1'">
      <DefineConstants>$(DefineConstants);LEGATO_SIRA_EARLY_CONTEXTS;LEGATO_SIRA_PUBLICIZED_ZENJECT;LEGATO_BEFORE_MULTIPLAYER</DefineConstants>
      <LegatoEarlyZenjectDirectory Condition="'$(LegatoEarlyZenjectDirectory)' == '' AND Exists('$(LegatoLibraryRoot)\Zenject.dll') AND Exists('$(LegatoLibraryRoot)\Zenject-usage.dll')">$(LegatoLibraryRoot)</LegatoEarlyZenjectDirectory>
      <LegatoEarlyZenjectDirectory Condition="'$(LegatoEarlyZenjectDirectory)' == ''">$(LegatoReferenceRoot)\Beat Saber_Data\Managed</LegatoEarlyZenjectDirectory>
    </PropertyGroup>
    <ItemGroup Condition="'$(LegatoTargetVersion)' == '0.11.1'">
      <Reference Remove="BGLib.AppFlow;BGLib.DotnetExtension;BGLib.Polyglot;BGLib.UnityExtension;BGNetCore;BeatSaber.Init;BeatmapCore;DataModels;GameplayCore;Unity.InputSystem;Unity.XR.Management;Unity.XR.OpenXR;UnityEngine.SpatialTracking;Zenject;Zenject-usage" />
      <Reference Include="Zenject" HintPath="$(LegatoEarlyZenjectDirectory)\Zenject.dll" Private="false" Publicize="true" />
      <Reference Include="Zenject-usage" HintPath="$(LegatoEarlyZenjectDirectory)\Zenject-usage.dll" Private="false" />
    </ItemGroup>
    <ItemGroup Condition="'$(LegatoTargetVersion)' == '1.11.1'">
      <Reference Remove="BGLib.AppFlow;BGLib.DotnetExtension;BGLib.Polyglot;BGLib.UnityExtension;BGNetCore;BeatSaber.Init;BeatmapCore;DataModels;GameplayCore;Unity.InputSystem;Unity.XR.Management;Unity.XR.OpenXR;UnityEngine.SpatialTracking" />
      <Reference Include="Colors" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Colors.dll" Private="false" />
      <Reference Include="Polyglot" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Polyglot.dll" Private="false" />
    </ItemGroup>
  </Target>
</Project>
