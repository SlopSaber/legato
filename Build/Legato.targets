  <Target Name="LegatoResolveEarlyGameReferences" BeforeTargets="ResolveAssemblyReferences"
          AfterTargets="BSIPA_ResolveLayoutReferences" DependsOnTargets="LegatoConfigure"
          Condition="'$(LegatoTargetVersion)' == '0.11.1' OR '$(LegatoTargetVersion)' == '0.11.2'">
    <ItemGroup>
      <Reference Remove="Main;HMUI;HMLib;VRUI;GameplayCore;Unity.TextMeshPro" />
      <Reference Include="Assembly-CSharp" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Assembly-CSharp.dll"
                 Private="false" Publicize="true"
                 Condition="'@(Reference->WithMetadataValue('Identity', 'Assembly-CSharp'))' == ''" />
      <Reference Include="Assembly-CSharp-firstpass" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Assembly-CSharp-firstpass.dll"
                 Private="false" Condition="'@(Reference->WithMetadataValue('Identity', 'Assembly-CSharp-firstpass'))' == ''" />
      <Reference Include="TextMeshPro-1.0.55.2017.1.0b12"
                 HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\TextMeshPro-1.0.55.2017.1.0b12.dll"
                 Private="false" Publicize="true"
                 Condition="'@(Reference->WithMetadataValue('Identity', 'TextMeshPro-1.0.55.2017.1.0b12'))' == ''" />
    </ItemGroup>
  </Target>

  <Target Name="LegatoBridgeReferencePublicizeMetadata" BeforeTargets="Publicize"
          Condition="'$(LegatoMetadataOnly)' != 'true' AND '$(LegatoUseReferencePublicizeMetadata)' == 'true'">
    <ItemGroup>
      <_LegatoPublicizeReference Include="@(Reference->WithMetadataValue('Publicize', 'true'))" />
      <Publicize Include="@(_LegatoPublicizeReference)" PublicizeTarget="All"
                 PublicizeCompilerGenerated="false" IncludeOriginalAttributesAttribute="false" Strip="false" />
    </ItemGroup>
  </Target>

  <Target Name="LegatoLoaderJsonReference" BeforeTargets="ResolveAssemblyReferences"
          DependsOnTargets="LegatoConfigure;BSIPA_ResolveLayoutReferences"
          Condition="'$(LegatoUseLoaderJson)' == 'true'">
    <ItemGroup>
      <Reference Update="@(Reference)" Condition="'%(Reference.Identity)' == 'Newtonsoft.Json' AND Exists('$(LegatoReferenceRoot)\IPA\CoreLibraries\Newtonsoft.Json.dll')">
        <HintPath>$(LegatoReferenceRoot)\IPA\CoreLibraries\Newtonsoft.Json.dll</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>

  <Target Name="LegatoPrepareManifest" BeforeTargets="BSMT_StartBSIPA;PrepareForBuild"
          DependsOnTargets="LegatoConfigure" Condition="'$(LegatoManifestFile)' != ''">
    <PropertyGroup>
      <_LegatoManifestInput>$(MSBuildProjectDirectory)\$(LegatoManifestFile)</_LegatoManifestInput>
      <_LegatoManifestOutput>$(IntermediateOutputPath)Legato\$(LegatoTargetVersion)\manifest.json</_LegatoManifestOutput>
      <_LegatoManifestResourceName Condition="'$(LegatoManifestResourceName)' == ''">$(RootNamespace).manifest.json</_LegatoManifestResourceName>
      <_LegatoManifestResourceName Condition="'$(LegatoManifestResourceName)' != ''">$(LegatoManifestResourceName)</_LegatoManifestResourceName>
      <_LegatoManifestText>$([System.IO.File]::ReadAllText('$(_LegatoManifestInput)'))</_LegatoManifestText>
      <_LegatoManifestText>$([System.Text.RegularExpressions.Regex]::Replace('$(_LegatoManifestText)', '&quot;gameVersion&quot;\s*:\s*&quot;[^&quot;]+&quot;', '&quot;gameVersion&quot;: &quot;$(LegatoTargetVersion)&quot;'))</_LegatoManifestText>
      <ManifestPath>$(_LegatoManifestOutput)</ManifestPath>
    </PropertyGroup>
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_LegatoManifestOutput)'))" />
    <WriteLinesToFile File="$(_LegatoManifestOutput)" Lines="$(_LegatoManifestText)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <ItemGroup>
      <EmbeddedResource Remove="$(LegatoManifestFile);$(_LegatoManifestInput)" />
      <EmbeddedResource Include="$(_LegatoManifestOutput)" LogicalName="$(_LegatoManifestResourceName)"
                        Condition="'$(LegatoEmbedManifest)' != 'false'" />
    </ItemGroup>
  </Target>

  <Target Name="LegatoCopyManifestSidecar" AfterTargets="Build"
          Condition="'$(LegatoManifestSidecar)' == 'true' AND '$(LegatoManifestFile)' != ''">
    <Copy SourceFiles="$(_LegatoManifestOutput)" DestinationFiles="$(TargetDir)$(AssemblyName).manifest"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="LegatoAddBaseSources" BeforeTargets="CoreCompile" DependsOnTargets="LegatoConfigure"
          Condition="'$(LegatoMetadataOnly)' != 'true'">
    <ItemGroup Condition="'$(LegatoEnablePolyfills)' != 'false' AND '$(_LegatoCoreApi)' != ''">
      <Compile Include="$(LegatoSourceRoot)GlobalUsings.cs;$(LegatoSourceRoot)Polyfills\System\**\*.cs;$(LegatoSourceRoot)Polyfills\UnityEngine\Networking\UnityWebRequest\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\AudioTimeSyncController\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\System\Collections\Concurrent\**\*.cs" Condition="'$(LegatoTargetProfile)' == '0.10.1'" />
      <Compile Condition="'$(_LegatoCoreApi)' == 'LegacyPreview'"
               Include="$(LegatoSourceRoot)Polyfills\GlobalNamespace\AudioManager\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\BeatmapKey\Versions\1.29.0\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\BeatmapLevel\Versions\1.29.0\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\IPreviewMediaData\Versions\1.29.0\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\StandardLevelScenesTransitionSetupData\*.cs" />
      <Compile Include="$(LegatoSourceRoot)Polyfills\GlobalNamespace\GameplayCoreSceneSetupData\Transitions\1.29.0-1.37.1\*.cs"
               Condition="'$(_LegatoCoreApi)' == 'LegacyPreview'" />
      <Compile Include="$(LegatoSourceRoot)Polyfills\GlobalNamespace\LevelSelectionNavigationController\LevelSelectionNavigationControllerExtensions.cs"
               Condition="'$(LegatoTargetProfile)' == '1.11.1' OR '$(LegatoTargetProfile)' == '1.12.1'" />
    </ItemGroup>
    <ItemGroup Condition="'$(LegatoEnablePolyfills)' != 'false' AND '$(_LegatoCoreApi)' == ''">
      <Compile Include="$(LegatoSourceRoot)GlobalUsings.cs;$(LegatoSourceRoot)Library\Platform\Authentication\**\*.cs;$(LegatoSourceRoot)Library\Platform\Friends\**\*.cs;$(LegatoSourceRoot)Library\XR\Headset\**\*.cs;$(LegatoSourceRoot)Library\XR\InputFocus\**\*.cs" />
      <Compile Include="$(LegatoSourceRoot)Polyfills\**\*.cs" Exclude="$(LegatoSourceRoot)Polyfills\System\**\*.cs" />
      <Compile Include="$(LegatoSourceRoot)Polyfills\System\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)**\Versions\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)ForwardPolyfills\**\*.cs" />
      <Compile Include="$(LegatoSourceRoot)Polyfills\**\Versions\$(_LegatoPolyfillProfile)\**\*.cs" Condition="'$(_LegatoPolyfillProfile)' != ''" />
      <Compile Include="$(LegatoSourceRoot)Polyfills\**\Versions\1.29.0-1.37.1\**\*.cs" Condition="'$(_LegatoPolyfillProfile)' == '1.29.0' OR '$(LegatoTargetProfile)' == '1.37.1'" />
      <Compile Include="$(LegatoSourceRoot)Polyfills\**\Versions\1.29.0-1.38.0\**\*.cs" Condition="'$(_LegatoPolyfillProfile)' == '1.29.0' OR '$(LegatoTargetProfile)' == '1.37.1' OR '$(LegatoTargetProfile)' == '1.38.0'" />
      <Compile Include="$(LegatoSourceRoot)Polyfills\**\Versions\1.29.0-1.40.0\**\*.cs" Condition="'$(_LegatoPolyfillProfile)' == '1.29.0' OR '$(LegatoTargetProfile)' == '1.37.1' OR '$(LegatoTargetProfile)' == '1.38.0' OR '$(LegatoTargetProfile)' == '1.40.0'" />
      <Compile Include="$(LegatoSourceRoot)Polyfills\**\Versions\1.37.1-1.40.0\**\*.cs" Condition="'$(LegatoTargetProfile)' == '1.37.1' OR '$(LegatoTargetProfile)' == '1.38.0' OR '$(LegatoTargetProfile)' == '1.40.0'" />
      <Compile Include="$(LegatoSourceRoot)ForwardPolyfills\**\Transitions\1.29.0-1.37.1\**\*.cs" Condition="'$(LegatoSourceOrder)' != '' AND '$(LegatoTargetOrder)' != '' AND $(LegatoSourceOrder) &lt;= 0.5 AND $(LegatoTargetOrder) &gt;= 1" />
      <Compile Remove="$(LegatoSourceRoot)Library\Presentation\**\*.cs;$(LegatoSourceRoot)Library\Resources\**\*.cs;$(LegatoSourceRoot)Polyfills\BeatSaberMarkupLanguage\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\UnityEngine\UI\Image\Versions\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\LeaderboardCore\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\SongCore\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\SongDataCore\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\TMPro\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\BS_Utils\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\SiraUtil\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\GlobalNamespace\BeatmapKey\BeatmapKeyExtensions.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\GlobalNamespace\BeatmapLevelPack\**\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\LevelCollectionNavigationController\BeatmapLevelPackAdapterExtensions.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\LevelCollectionViewController\BeatmapLevelPackAdapterExtensions.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\LevelCollectionViewController\BeatmapLevelSelectionSubscription.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\LevelFilteringNavigationController\**\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\LevelSelectionNavigationController\LevelSelectionSession.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\StandardLevelDetailViewController\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Library\Beatmaps\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Library\Gameplay\GameplayMetadataProvider.cs;$(LegatoSourceRoot)Library\Platform\**\*.cs;$(LegatoSourceRoot)Library\Rooms\**\*.cs;$(LegatoSourceRoot)Library\XR\XrDeviceDiscovery.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\GlobalNamespace\MainCamera\**\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\OculusVRHelper\**\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\PauseController\**\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\UnityXRHelper\**\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\UnityXRSystemState\**\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\VariableMovementDataProvider\**\*.cs" />
    </ItemGroup>
  </Target>

  <Target Name="LegatoAddOptionalSources" BeforeTargets="CoreCompile" DependsOnTargets="LegatoAddBaseSources;ResolveReferences"
          Condition="'$(LegatoMetadataOnly)' != 'true'">
    <ItemGroup>
      <_LegatoBSMLReference Include="@(ReferencePath->WithMetadataValue('Filename', 'BSML'))" />
      <_LegatoTextMeshProReference Include="@(ReferencePath->WithMetadataValue('Filename', 'Unity.TextMeshPro'))" />
      <_LegatoLeaderboardCoreReference Include="@(ReferencePath->WithMetadataValue('Filename', 'LeaderboardCore'))" />
      <_LegatoSiraUtilReference Include="@(ReferencePath->WithMetadataValue('Filename', 'SiraUtil'))" />
      <_LegatoSongCoreReference Include="@(ReferencePath->WithMetadataValue('Filename', 'SongCore'))" />
      <_LegatoSongDataCoreReference Include="@(ReferencePath->WithMetadataValue('Filename', 'SongDataCore'))" />
      <_LegatoSongDetailsReference Include="@(ReferencePath->WithMetadataValue('Filename', 'SongDetailsCache'))" />
      <_LegatoBSUtilsReference Include="@(ReferencePath->WithMetadataValue('Filename', 'BS_Utils'))" />
      <_LegatoIPAReference Include="@(ReferencePath->WithMetadataValue('Filename', 'IPA.Loader'))" />
      <_LegatoGameSettingsReference Include="@(ReferencePath->WithMetadataValue('Filename', 'BeatSaber.GameSettings'))" />
      <_LegatoPlatformUserModelReference Include="@(ReferencePath->WithMetadataValue('Filename', 'PlatformUserModel'))" />
      <_LegatoOculusPlatformReference Include="@(ReferencePath->WithMetadataValue('Filename', 'Oculus.Platform'))" />
      <_LegatoPlatformCoreReference Include="@(ReferencePath->WithMetadataValue('Filename', 'OculusStudios.Platform.Core'))" />
      <_LegatoSteamReference Include="@(ReferencePath->WithMetadataValue('Filename', 'com.rlabrecque.steamworks.net'))" />
      <_LegatoHarmonyReference Include="@(ReferencePath->WithMetadataValue('Filename', '0Harmony'))" />
      <_LegatoHttpReference Include="@(ReferencePath->WithMetadataValue('Filename', 'System.Net.Http'))" />
      <_LegatoSpatialTrackingReference Include="@(ReferencePath->WithMetadataValue('Filename', 'UnityEngine.SpatialTracking'))" />
      <_LegatoXRReference Include="@(ReferencePath->WithMetadataValue('Filename', 'UnityEngine.XRModule'))" />
      <_LegatoOpenXRReference Include="@(ReferencePath->WithMetadataValue('Filename', 'Unity.XR.OpenXR'))" />
      <_LegatoMainReference Include="@(ReferencePath->WithMetadataValue('Filename', 'Main'))" />
      <_LegatoDataModelsReference Include="@(ReferencePath->WithMetadataValue('Filename', 'DataModels'))" />
      <_LegatoAudioReference Include="@(ReferencePath->WithMetadataValue('Filename', 'BeatSaber.Audio.Common'))" />
      <_LegatoColorsReference Include="@(ReferencePath->WithMetadataValue('Filename', 'Colors'))" />
      <_LegatoGameplayCoreReference Include="@(ReferencePath->WithMetadataValue('Filename', 'GameplayCore'))" />
      <_LegatoUnityReference Include="@(ReferencePath->WithMetadataValue('Filename', 'UnityEngine.CoreModule'))" />
      <_LegatoZenjectReference Include="@(ReferencePath->WithMetadataValue('Filename', 'Zenject'))" />
      <_LegatoHMLibReference Include="@(ReferencePath->WithMetadataValue('Filename', 'HMLib'))" />
    </ItemGroup>
    <GetAssemblyIdentity AssemblyFiles="@(_LegatoBSMLReference)" Condition="'@(_LegatoBSMLReference)' != ''">
      <Output TaskParameter="Assemblies" ItemName="_LegatoBsmlIdentity" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <_LegatoBsmlApiVersion>@(_LegatoBsmlIdentity->'%(Version)')</_LegatoBsmlApiVersion>
      <DefineConstants Condition="'$(_LegatoBsmlApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoBsmlApiVersion)', '1.14.0.0'))">$(DefineConstants);LEGATO_BSML_CURRENT</DefineConstants>
      <DefineConstants Condition="'$(LegatoEnableBSML)' == 'true' AND ('$(LegatoTargetVersion)' == '0.11.1' OR '$(LegatoTargetVersion)' == '0.11.2')">$(DefineConstants);LEGATO_EARLY_VR_UI;LEGATO_HMUI_PLAIN_TMP</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(LegatoEnableAutoAdapters)' != 'false' AND '$(_LegatoCoreApi)' == ''">
      <LegatoEnableBSML Condition="'$(LegatoEnableBSML)' == '' AND '@(_LegatoBSMLReference)' != ''">true</LegatoEnableBSML>
      <LegatoEnableTextMeshPro Condition="'$(LegatoEnableTextMeshPro)' == '' AND '@(_LegatoTextMeshProReference)' != ''">true</LegatoEnableTextMeshPro>
      <LegatoEnableLeaderboardCore Condition="'$(LegatoEnableLeaderboardCore)' == '' AND '@(_LegatoLeaderboardCoreReference)' != ''">true</LegatoEnableLeaderboardCore>
      <LegatoEnableSiraUtil Condition="'$(LegatoEnableSiraUtil)' == '' AND '@(_LegatoSiraUtilReference)' != ''">true</LegatoEnableSiraUtil>
      <LegatoEnableSongCore Condition="'$(LegatoEnableSongCore)' == '' AND '@(_LegatoSongCoreReference)' != ''">true</LegatoEnableSongCore>
      <LegatoEnableSongDataCompatibility Condition="'$(LegatoEnableSongDataCompatibility)' == '' AND '@(_LegatoSongDataCoreReference)' == '' AND '@(_LegatoSongDetailsReference)' != ''">true</LegatoEnableSongDataCompatibility>
      <LegatoEnableBSUtils Condition="'$(LegatoEnableBSUtils)' == '' AND '@(_LegatoBSUtilsReference)' != ''">true</LegatoEnableBSUtils>
      <LegatoEnableGameSettings Condition="'$(LegatoEnableGameSettings)' == '' AND '@(_LegatoGameSettingsReference)' != ''">true</LegatoEnableGameSettings>
      <LegatoEnablePlatform Condition="'$(LegatoEnablePlatform)' == '' AND '$(LegatoTargetProfile)' == '1.29.0' AND '@(_LegatoMainReference)' != '' AND '@(_LegatoOculusPlatformReference)' != ''">true</LegatoEnablePlatform>
      <LegatoEnablePlatform Condition="'$(LegatoEnablePlatform)' == '' AND ('$(LegatoTargetProfile)' == '1.37.1' OR '$(LegatoTargetProfile)' == '1.38.0' OR '$(LegatoTargetProfile)' == '1.40.0') AND '@(_LegatoPlatformUserModelReference)' != ''">true</LegatoEnablePlatform>
      <LegatoEnablePlatform Condition="'$(LegatoEnablePlatform)' == '' AND '$(LegatoTargetProfile)' == '1.42.0' AND '@(_LegatoPlatformCoreReference)' != '' AND '@(_LegatoSteamReference)' != ''">true</LegatoEnablePlatform>
      <LegatoEnableHarmonyEvents Condition="'$(LegatoEnableHarmonyEvents)' == '' AND '@(_LegatoHarmonyReference)' != ''">true</LegatoEnableHarmonyEvents>
      <LegatoEnableHttp Condition="'$(LegatoEnableHttp)' == '' AND '@(_LegatoHttpReference)' != ''">true</LegatoEnableHttp>
      <LegatoEnableSpatialTracking Condition="'$(LegatoEnableSpatialTracking)' == '' AND '@(_LegatoSpatialTrackingReference)' != ''">true</LegatoEnableSpatialTracking>
      <LegatoEnableXR Condition="'$(LegatoEnableXR)' == '' AND '@(_LegatoXRReference)' != '' AND ('$(LegatoTargetProfile)' == '1.29.0' OR '@(_LegatoOpenXRReference)' != '')">true</LegatoEnableXR>
      <LegatoEnableGameplay Condition="'$(LegatoEnableGameplay)' == '' AND '$(LegatoTargetProfile)' == '1.29.0' AND '@(_LegatoMainReference)' != '' AND '@(_LegatoUnityReference)' != '' AND '@(_LegatoZenjectReference)' != ''">true</LegatoEnableGameplay>
      <LegatoEnableGameplay Condition="'$(LegatoEnableGameplay)' == '' AND '$(LegatoTargetProfile)' != '1.29.0' AND '@(_LegatoMainReference)' != '' AND '@(_LegatoDataModelsReference)' != '' AND '@(_LegatoColorsReference)' != '' AND '@(_LegatoGameplayCoreReference)' != '' AND '@(_LegatoUnityReference)' != '' AND '@(_LegatoZenjectReference)' != ''">true</LegatoEnableGameplay>
      <LegatoEnableCoroutines Condition="'$(LegatoEnableCoroutines)' == '' AND '@(_LegatoHMLibReference)' != '' AND '@(_LegatoUnityReference)' != ''">true</LegatoEnableCoroutines>
    </PropertyGroup>
    <ItemGroup>
      <Compile Include="$(LegatoSourceRoot)ForwardPolyfills\**\Transitions\1.37.1-1.38.0\**\*.cs"
               Condition="'@(_LegatoDataModelsReference)' != '' AND '$(LegatoSourceOrder)' != '' AND '$(LegatoTargetOrder)' != '' AND $(LegatoSourceOrder) &lt;= 1 AND $(LegatoTargetOrder) &gt;= 2" />
      <Compile Include="$(LegatoSourceRoot)Library\Results\**\*.cs"
               Condition="'$(LegatoEnableResults)' == 'true' OR ('$(LegatoEnableAutoAdapters)' != 'false' AND '@(_LegatoIPAReference)' != '' AND '@(_LegatoGameplayCoreReference)' != '')" />
      <Compile Include="$(LegatoSourceRoot)Library\Characteristics\**\*.cs;$(LegatoSourceRoot)Library\LegacyNames\**\*.cs"
               Condition="'$(LegatoEnableLegacyTypeNames)' == 'true'" />
      <Compile Include="$(LegatoSourceRoot)Library\EffectLifecycle\**\*.cs"
               Condition="'$(LegatoEnableEffectLifecycle)' == 'true'" />
      <Compile Include="$(LegatoSourceRoot)Library\LevelProxies\**\*.cs"
               Condition="'$(LegatoEnableLevelProxies)' == 'true'" />
      <Compile Include="$(LegatoSourceRoot)Library\LevelProxies\EarlyMapFiles.cs"
               Condition="('$(LegatoTargetVersion)' == '0.11.1' OR '$(LegatoTargetVersion)' == '0.11.2') AND '$(LegatoEnableLevelListBadges)' == 'true' AND '$(LegatoEnableLevelProxies)' != 'true'" />
      <Compile Include="$(LegatoSourceRoot)Providers\CustomJSONData\Legacy\EarlyBeatmapSources.cs"
               Condition="('$(LegatoTargetVersion)' == '0.11.1' OR '$(LegatoTargetVersion)' == '0.11.2') AND '$(LegatoEnableLevelProxies)' == 'true' AND '$(LegatoEnableCustomJsonDataProviders)' != 'true'" />
      <Compile Include="$(LegatoSourceRoot)Library\StatisticsViews\**\*.cs"
               Condition="'$(LegatoEnableStatisticsViews)' == 'true'" />
      <Compile Include="$(LegatoSourceRoot)Library\Physics\**\*.cs"
               Condition="'$(LegatoEnablePhysics)' == 'true'" />
      <Compile Include="$(LegatoSourceRoot)Library\ComponentBindings\**\*.cs"
               Condition="'$(LegatoEnableComponentBindings)' == 'true' OR '$(LegatoEnableSongCoreProviders)' == 'true'" />
      <Compile Include="$(LegatoSourceRoot)Library\BsmlTableSources\**\*.cs"
               Condition="'$(LegatoEnableBsmlTableSources)' == 'true'" />
      <Compile Include="$(LegatoSourceRoot)Library\FlowNavigation\**\*.cs"
               Condition="'$(LegatoEnableFlowNavigation)' == 'true'" />
      <Compile Include="$(LegatoSourceRoot)Providers\Shaffuru\**\*.cs" Condition="'$(LegatoEnableShaffuruProviders)' == 'true'" />
      <Compile Include="$(LegatoSourceRoot)Library\AudioSettings\**\*.cs" Condition="'$(LegatoEnableAudioSettings)' == 'true'" />
      <Compile Include="$(LegatoSourceRoot)Library\JumpSelectionContext\**\*.cs" Condition="'$(LegatoEnableJumpSelectionContext)' == 'true'" />
      <Compile Include="$(LegatoSourceRoot)Providers\SiraLocalizer\**\*.cs" Condition="'$(LegatoEnableSiraLocalizerProviders)' == 'true'" />
      <Compile Include="$(LegatoSourceRoot)Library\LocalizationAccess\**\*.cs" Condition="'$(LegatoEnableLocalizationAccess)' == 'true'" />
      <Compile Include="$(LegatoSourceRoot)Library\LocalizationResource\**\*.cs" Condition="'$(LegatoEnableLocalizationResource)' == 'true'" />
      <Compile Include="$(LegatoSourceRoot)Library\PortableFonts\**\*.cs" Condition="'$(LegatoEnablePortableFonts)' == 'true'" />
      <Compile Include="$(LegatoSourceRoot)Library\FontResources\**\*.cs" Condition="'$(LegatoEnableFontResources)' == 'true'" />
      <Compile Include="$(LegatoSourceRoot)Library\AsyncFiles\**\*.cs" Condition="'$(LegatoEnableAsyncFiles)' == 'true'" />
