<Project>
  <Import Project="$(MSBuildThisFileDirectory)AssetBundles.targets" />
  <Import Project="$(MSBuildProjectFullPath).user" Condition="'$(LegatoMetadataOnly)' != 'true' AND '$(BeatSaberDir)' == '' AND Exists('$(MSBuildProjectFullPath).user')" />

  <ItemGroup>
    <EditorConfigFiles Include="$(LegatoSourceRoot)Library\.editorconfig" />
  </ItemGroup>

  <PropertyGroup>
    <LegatoTargetVersion Condition="'$(LegatoTargetVersion)' == ''">$(LegatoCurrentVersion)</LegatoTargetVersion>
    <LegatoSourceVersion Condition="'$(LegatoSourceVersion)' == '' AND '$(GameVersion)' != ''">$(GameVersion)</LegatoSourceVersion>
    <LegatoSourceVersion Condition="'$(LegatoSourceVersion)' == ''">$(LegatoCurrentVersion)</LegatoSourceVersion>
    <LegatoReferenceRoot Condition="'$(GameReferences)' != ''">$(GameReferences)</LegatoReferenceRoot>
    <LegatoReferenceRoot Condition="'$(LegatoReferenceRoot)' == ''">$(BeatSaberDir)</LegatoReferenceRoot>
    <LegatoLibraryRoot>$(LegatoReferenceRoot)\Libs</LegatoLibraryRoot>
    <LegatoLibraryRoot Condition="Exists('$(LegatoReferenceRoot)\IPA\Data\Managed\IPA.Loader.dll')">$(LegatoReferenceRoot)\Mods\Libraries</LegatoLibraryRoot>
    <LegatoLibraryRoot Condition="Exists('$(LegatoReferenceRoot)\IPA\Pending\Libraries')">$(LegatoReferenceRoot)\IPA\Pending\Libraries</LegatoLibraryRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LegatoAliasBsmlReference)' == 'true'">
    <DefineConstants>$(DefineConstants);LEGATO_BSML_ALIASED</DefineConstants>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)AsyncInterfaces.targets" />
  <Import Project="$(MSBuildThisFileDirectory)ShaffuruProviders.targets" />
  <Import Project="$(MSBuildThisFileDirectory)SiraLocalizerProviders.targets" />
  <Target Name="LegatoConfigure" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <_LegatoTargetVersion Include="@(LegatoGameVersion->WithMetadataValue('Identity', '$(LegatoTargetVersion)'))" />
      <_LegatoSourceVersion Include="@(LegatoGameVersion->WithMetadataValue('Identity', '$(LegatoSourceVersion)'))" />
      <_LegatoPortableShaderProfile Include="@(LegatoPortableShaderProfile->WithMetadataValue('Identity', '$(LegatoTargetVersion)'))"
                                   Condition="'$(LegatoEnablePortableRendering)' == 'true' OR '$(LegatoEnableCinemaAssets)' == 'true'" />
    </ItemGroup>
    <PropertyGroup>
      <LegatoTargetProfile>@(_LegatoTargetVersion->'%(Profile)')</LegatoTargetProfile>
      <LegatoPortableShaderBundleTarget>@(_LegatoPortableShaderProfile->'%(BundleTarget)')</LegatoPortableShaderBundleTarget>
      <_LegatoPortablePipeline Condition="'$(LegatoEnablePortableRendering)' == 'true'">@(_LegatoPortableShaderProfile->'%(Pipeline)')</_LegatoPortablePipeline>
      <LegatoTargetOrder>@(_LegatoTargetVersion->'%(Order)')</LegatoTargetOrder>
      <LegatoSourceProfile>@(_LegatoSourceVersion->'%(Profile)')</LegatoSourceProfile>
      <LegatoSourceOrder>@(_LegatoSourceVersion->'%(Order)')</LegatoSourceOrder>
      <_LegatoCoreApi>@(_LegatoTargetVersion->'%(CoreApi)')</_LegatoCoreApi>
      <_LegatoApiVersion Condition="'$(LegatoTargetProfile)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('$(LegatoTargetVersion)', 'p[0-9]+$', ''))</_LegatoApiVersion>
      <_LegatoPolyfillProfile>$(LegatoTargetProfile)</_LegatoPolyfillProfile>
      <_LegatoPolyfillProfile Condition="'$(LegatoTargetProfile)' == '1.29.4' OR '$(LegatoTargetProfile)' == '1.34.2'">1.29.0</_LegatoPolyfillProfile>
      <_LegatoUsesDifficultyBeatmaps Condition="'$(_LegatoPolyfillProfile)' == '1.29.0' OR '$(_LegatoCoreApi)' == 'LegacyPreview'">true</_LegatoUsesDifficultyBeatmaps>
      <LegatoTargetDefine Condition="'$(LegatoTargetProfile)' != ''">BEAT_SABER_$([System.String]::Copy('$(LegatoTargetProfile)').Replace('.', '_'))</LegatoTargetDefine>
      <DefineConstants Condition="'$(LegatoTargetDefine)' != ''">$(DefineConstants);$(LegatoTargetDefine);@(_LegatoTargetVersion->'%(Constants)')</DefineConstants>
      <DefineConstants Condition="'$(LegatoEnableGameplayAnchors)' == 'true' AND ('$(LegatoTargetVersion)' == '0.11.1' OR '$(LegatoTargetVersion)' == '0.11.2')">$(DefineConstants);LEGATO_EARLY_GAMEPLAY_ANCHORS</DefineConstants>
      <DefineConstants Condition="'$(LegatoEnableAssetBundleHost)' == 'true' AND '$(LegatoTargetVersion)' == '0.11.1'">$(DefineConstants);LEGATO_EARLY_ASSET_BUNDLE_HOST;LEGATO_BEFORE_MULTIPLAYER</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.37.2'))">$(DefineConstants);LEGATO_INTEGER_REFRESH_RATE;LEGATO_LEGACY_FRAME_TIMING;LEGATO_BASIC_TEXTURE_CREATION_FLAGS</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.37.2'))">$(DefineConstants);LEGATO_LINE_RENDERER_TEXTURE_SCALE</DefineConstants>
      <DefineConstants Condition="'$(LegatoEnablePhysics)' == 'true' AND '$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.40.9'))">$(DefineConstants);LEGATO_UNITY_6_RIGIDBODY</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.37.3'))">$(DefineConstants);LEGATO_PACK_CONTENT_WITHOUT_PURCHASE_OPTIONS</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.36.2')) AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.37.3'))">$(DefineConstants);LEGATO_MAIN_SETTINGS_HANDLER</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.37.3'))">$(DefineConstants);LEGATO_QUALITY_SETTINGS_MANAGER</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.37.3'))">$(DefineConstants);LEGATO_LEVEL_DETAIL_METRICS_SET_DATA</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.37.3'))">$(DefineConstants);LEGATO_CACHED_RENDERER_MATERIAL_COUNTS</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.37.4'))">$(DefineConstants);LEGATO_CUTTABLE_SCORING_OBJECT_COUNT;LEGATO_BEATMAP_OBJECT_BEAT</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.37.4'))">$(DefineConstants);LEGATO_ENVIRONMENT_COLOR_PROVIDER</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.37.4'))">$(DefineConstants);LEGATO_SABER_VISUAL_ENDPOINTS</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.38.0'))">$(DefineConstants);LEGATO_DEPTH_TEXTURE_SETTINGS_INIT</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.38.0'))">$(DefineConstants);LEGATO_LEVEL_BAR_CACHES_LEVEL</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.38.0'))">$(DefineConstants);LEGATO_HMUI_VIEW_LIFECYCLE;LEGATO_NESTED_MENU_LIGHT_PAIR</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.38.0'))">$(DefineConstants);LEGATO_STANDARD_LEVEL_RESTART_CALLBACK</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.37.4'))">$(DefineConstants);LEGATO_UNTYPED_SCENE_TRANSITIONS;LEGATO_LEGACY_AVAILABLE_CHARACTERISTICS_FIELD;LEGATO_PRIVATE_POINTER_CURSOR;LEGATO_SELECT_ROW_EVENT;LEGATO_FAIL_ON_ZERO_ENERGY;LEGATO_LEGACY_FLOW_OVERRIDE</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.37.4'))">$(DefineConstants);LEGATO_PARAMETERLESS_HIDE_HINT</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.38.0'))">$(DefineConstants);LEGATO_CANCELLABLE_COVER_LOADING;LEGATO_SINGLE_BEATMAP_ENVIRONMENT</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.37.1')) AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.38.0'))">$(DefineConstants);LEGATO_DEPTH_TEXTURE_AT_START</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.39.0'))">$(DefineConstants);LEGATO_PRIVATE_SONG_START_TIME;LEGATO_SPAWN_ROTATION_EVENTS</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.39.0'))">$(DefineConstants);LEGATO_BEATMAP_OBJECT_ROTATION</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.40.0'))">$(DefineConstants);LEGATO_SINGLE_COLOR_OVERRIDE;LEGATO_SLIDER_SCORING_TYPES;LEGATO_LEGACY_OBSTACLE_PROPERTIES</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.40.0'))">$(DefineConstants);LEGATO_VARIABLE_MOVEMENT_DATA</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.40.0'))">$(DefineConstants);LEGATO_LEGACY_CONTROLLER_MODEL_OFFSET;LEGATO_ENUM_PAUSE_STATE;LEGATO_MODAL_IS_SHOWN</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.40.2'))">$(DefineConstants);LEGATO_QUERY_CONTROLLER_POSE</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.40.2'))">$(DefineConstants);LEGATO_CONTROLLER_FOCUS_CAPTURE</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.39.0')) AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.40.2'))">$(DefineConstants);LEGATO_MENU_CONTROLLER_FOCUS_CAPTURE</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.40.4'))">$(DefineConstants);LEGATO_MONOBEHAVIOUR_INTERACTABLE</DefineConstants>
      <DefineConstants Condition="'$(LegatoTargetVersion)' == '1.40.0'">$(DefineConstants);LEGATO_INITIAL_MOVE_DISTANCE</DefineConstants>
      <DefineConstants Condition="'$(LegatoTargetVersion)' == '1.40.0' OR '$(LegatoTargetVersion)' == '1.40.1'">$(DefineConstants);LEGATO_LEGACY_HEAD_Z_FIELD_NAME</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.40.9'))">$(DefineConstants);LEGATO_PARENTED_RING_PREFAB;LEGATO_SLIDER_ANGLE_OFFSETS;LEGATO_INJECTED_SABER_TRAIL;LEGATO_UNITY_AWAITABLE_OPERATIONS</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.40.9'))">$(DefineConstants);LEGATO_KEYBOARD_CAPS_LOCK_STATE</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.40.9'))">$(DefineConstants);LEGATO_STATIC_TIME_HELPER</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.40.11'))">$(DefineConstants);LEGATO_SYNC_CONTROLLER_AUDIO_STATE</DefineConstants>
      <LegatoUsesBuiltInRendering Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.41.1'))">true</LegatoUsesBuiltInRendering>
      <DefineConstants Condition="'$(LegatoUsesBuiltInRendering)' == 'true'">$(DefineConstants);LEGATO_BUILT_IN_RENDERING</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.41.1'))">$(DefineConstants);LEGATO_LOCALIZATION_REMOVE_LISTENER</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.45.1'))">$(DefineConstants);LEGATO_XR_APP_FOCUS_QUERY;LEGATO_XR_URP_RENDER_SCALE</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.45.0'))">$(DefineConstants);LEGATO_LEGACY_MIRROR_RENDERER</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.44.2'))">$(DefineConstants);LEGATO_BLOOM_RENDER_TEXTURE</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.45.0'))">$(DefineConstants);LEGATO_TRANSFORMED_BEATMAP_LOADER</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.45.1'))">$(DefineConstants);LEGATO_URP_DRAW_MAIN_OPAQUE_FLAG</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.45.1'))">$(DefineConstants);LEGATO_LINE_RENDERER_COLOR_SPACE</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.41.1'))">$(DefineConstants);LEGATO_CHARACTERISTIC_NAME_PROPERTY;LEGATO_LEGACY_SCENE_NAMES;LEGATO_PLATFORM_USER_MODEL;LEGATO_GAMEPLAY_WITHOUT_ADDITIONAL_INFORMATION;LEGATO_BURN_MARKS_START</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.41.1'))">$(DefineConstants);LEGATO_TRANSITION_ENVIRONMENT_OVERRIDE</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.43.0'))">$(DefineConstants);LEGATO_PAUSE_MENU_CONTROLLERS</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.41.1'))">$(DefineConstants);LEGATO_MIXER_MUSIC_PITCH</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.41.1'))">$(DefineConstants);LEGATO_BEATMAP_LOAD_ERROR_MESSAGE</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.41.1'))">$(DefineConstants);LEGATO_CONTROLLER_AUTOPLAY</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.41.1'))">$(DefineConstants);LEGATO_NATIVE_RANDOM_PROVIDER</DefineConstants>
      <DefineConstants Condition="'$(LegatoTargetVersion)' == '1.41.1'">$(DefineConstants);LEGATO_TUTORIAL_WITHOUT_ADDITIONAL_INFORMATION</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.42.0'))">$(DefineConstants);LEGATO_SINGLE_UI_AUDIO_SOURCE</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.42.0'))">$(DefineConstants);LEGATO_CONTROLLER_NODE_IDX</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.29.4')) AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.43.0'))">$(DefineConstants);LEGATO_ENABLED_LAST_SELECTED_POINTER</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionLessThan('$(_LegatoApiVersion)', '1.44.2'))">$(DefineConstants);LEGATO_SCRIPTABLE_CHARACTERISTICS;LEGATO_SCRIPTABLE_SCENE_TRANSITIONS;LEGATO_DICTIONARY_BEATMAP_CALLBACKS</DefineConstants>
      <DefineConstants Condition="'$(_LegatoApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoApiVersion)', '1.44.2'))">$(DefineConstants);LEGATO_XR_SYSTEM_STATE</DefineConstants>
      <DefineConstants Condition="'$(LegatoTargetOrder)' != '' AND $(LegatoTargetOrder) &gt;= 1 AND $(LegatoTargetOrder) &lt; 4">$(DefineConstants);LEGATO_PC_APP_INIT</DefineConstants>
      <DefineConstants Condition="'$(LegatoTargetOrder)' != '' AND $(LegatoTargetOrder) &gt;= 4">$(DefineConstants);LEGATO_NATIVE_ZENJECT_COMPONENT_BINDER</DefineConstants>
      <DefineConstants Condition="'$(_LegatoUsesDifficultyBeatmaps)' == 'true'">$(DefineConstants);LEGATO_DIFFICULTY_BEATMAPS</DefineConstants>
      <DefineConstants Condition="'$(_LegatoCoreApi)' != ''">$(DefineConstants);LEGATO_HISTORICAL_GAME</DefineConstants>
      <DefineConstants Condition="'$(_LegatoCoreApi)' == 'EarlyAccess' OR '$(LegatoTargetProfile)' == '1.0.0'">$(DefineConstants);LEGATO_AUDIO_WITHOUT_STATE</DefineConstants>
      <DefineConstants Condition="'$(LegatoTargetVersion)' == '0.11.1' OR '$(LegatoTargetVersion)' == '0.11.2'">$(DefineConstants);LEGATO_WITHOUT_HTTP_CLIENT;LEGATO_LEGACY_IMAGE_SLICING;LEGATO_LEGACY_RENDER_TEXTURE_MIPS</DefineConstants>
      <DefineConstants Condition="'$(LegatoTargetVersion)' == '0.11.1'">$(DefineConstants);LEGATO_EARLY_SCENE_SETUP</DefineConstants>
      <DefineConstants Condition="'$(LegatoTargetVersion)' == '0.11.2'">$(DefineConstants);LEGATO_EARLY_STANDARD_MAPS</DefineConstants>
      <DefineConstants Condition="'$(LegatoEnableNativeBeatmapAliases)' == 'true'">$(DefineConstants);LEGATO_NATIVE_BEATMAP_KEYS</DefineConstants>
      <DefineConstants Condition="'$(LegatoEnableSteamAuthentication)' == 'true'">$(DefineConstants);LEGATO_STEAM_WEB_AUTH</DefineConstants>
      <LegatoHasDefaultInterfaceMethods Condition="'$(LegatoTargetProfile)' != '1.29.0' AND '$(LegatoTargetProfile)' != '' AND '$(_LegatoCoreApi)' == ''">true</LegatoHasDefaultInterfaceMethods>
      <DefineConstants Condition="'$(LegatoHasDefaultInterfaceMethods)' == 'true'">$(DefineConstants);LEGATO_DEFAULT_INTERFACE_METHODS</DefineConstants>
      <LegatoUsesNativeRenderTiming>false</LegatoUsesNativeRenderTiming>
      <LegatoUsesNativeRenderTiming Condition="'$(LegatoTargetVersion)' == '1.11.1' OR '$(LegatoTargetProfile)' == '1.29.0' OR '$(LegatoTargetProfile)' == '1.45.1' OR '$(LegatoTargetProfile)' == '1.45.3'">true</LegatoUsesNativeRenderTiming>
      <DefineConstants Condition="'$(LegatoEnableGpuTiming)' == 'true' AND '$(LegatoUsesNativeRenderTiming)' == 'true'">$(DefineConstants);LEGATO_NATIVE_GPU_TIMING</DefineConstants>
    </PropertyGroup>
    <Error Condition="'$(LegatoTargetProfile)' == ''" Text="Legato does not support Beat Saber $(LegatoTargetVersion)" />
    <Error Condition="'$(LegatoSourceProfile)' == ''" Text="Legato does not support source written for Beat Saber $(LegatoSourceVersion)" />
    <Error Condition="'$(LegatoEnablePortableRendering)' == 'true' AND '$(LegatoPortableShaderBundleTarget)' == ''"
           Text="Portable rendering has no exact profile for Beat Saber $(LegatoTargetVersion)." />
  </Target>

  <Target Name="LegatoPrepareBuildMetadata" BeforeTargets="BeforeBuild;GenerateManifest;GenerateBSMLManifest;BSMT_StartBSIPA;BSMT_GenerateManifest;PrepareForBuild"
          DependsOnTargets="LegatoConfigure" Condition="'$(LegatoMetadataOnly)' == 'true'">
    <PropertyGroup>
      <GameVersion>$(LegatoTargetVersion)</GameVersion>
    </PropertyGroup>
    <Error Condition="'$(GameVersion)' != '$(LegatoTargetVersion)'"
           Text="GameVersion and LegatoTargetVersion must select the same game version." />
    <Message Importance="High" Text="Legato metadata profile: $(LegatoTargetVersion) ($(LegatoTargetProfile))" />
  </Target>

  <Target Name="LegatoAddRequiredReferences" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="LegatoConfigure"
          Condition="'$(LegatoMetadataOnly)' != 'true' AND '$(LegatoEnableReferenceShims)' != 'false'">
    <ItemGroup>
      <Reference Include="Interactable" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Interactable.dll" Private="false"
                 Condition="'@(Reference->WithMetadataValue('Filename', 'HMUI'))' != '' AND '@(Reference->WithMetadataValue('Filename', 'Interactable'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Interactable.dll')" />
      <Reference Include="BGLib.SaveDataCore" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGLib.SaveDataCore.dll" Private="false"
                 Condition="('$(LegatoEnableScreenDisplacement)' == 'true' OR '$(LegatoEnableMutableSettings)' == 'true' OR '$(LegatoEnableMirrorSettings)' == 'true' OR '$(LegatoEnableMenuEnvironmentColors)' == 'true' OR ('$(LegatoEnableAudioSettings)' == 'true' AND '$(LegatoTargetProfile)' == '1.37.1')) AND '@(Reference->WithMetadataValue('Filename', 'BGLib.SaveDataCore'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGLib.SaveDataCore.dll')" />
      <Reference Include="BeatSaber.PerformancePresets" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BeatSaber.PerformancePresets.dll" Private="false"
                 Condition="('$(LegatoEnableScreenDisplacement)' == 'true' OR '$(LegatoEnableMirrorSettings)' == 'true' OR '$(LegatoEnableMenuEnvironmentColors)' == 'true' OR ('$(LegatoEnableShaffuruProviders)' == 'true' AND '$(LegatoTargetProfile)' == '1.37.1')) AND '@(Reference->WithMetadataValue('Filename', 'BeatSaber.PerformancePresets'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BeatSaber.PerformancePresets.dll')" />
      <Reference Include="Colors" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Colors.dll" Private="false"
                 Condition="'$(LegatoEnableBeatmapKeys)' == 'true' AND '@(Reference->WithMetadataValue('Identity', 'Colors'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Colors.dll')" />
      <Reference Include="BGNet" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGNet.dll" Private="false"
                 Condition="'$(LegatoEnablePlatformAuthentication)' == 'true' AND '$(LegatoTargetProfile)' == '1.29.0' AND '@(Reference->WithMetadataValue('Identity', 'BGNet'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGNet.dll')" />
      <Reference Include="PlatformUserModel" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\PlatformUserModel.dll" Private="false"
                 Condition="'$(LegatoEnablePlatformAuthentication)' == 'true' AND '@(Reference->WithMetadataValue('Identity', 'PlatformUserModel'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\PlatformUserModel.dll')" />
      <Reference Include="BGNetCore" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGNetCore.dll" Private="false"
                 Condition="'$(LegatoEnablePlatformAuthentication)' == 'true' AND '@(Reference->WithMetadataValue('Identity', 'BGNetCore'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGNetCore.dll')" />
      <Reference Remove="OculusStudios.Platform.Core" Condition="'$(LegatoEnablePlatformAuthentication)' == 'true' AND !Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\OculusStudios.Platform.Core.dll')" />
      <Reference Include="Unity.RenderPipelines.Core.Runtime;Unity.RenderPipelines.Universal.Runtime"
                 Condition="'$(_LegatoPortablePipeline)' == 'Universal' OR ('$(LegatoEnableCameraEffects)' == 'true' AND ('$(LegatoTargetProfile)' == '1.45.1' OR '$(LegatoTargetProfile)' == '1.45.3'))">
        <HintPath>$(LegatoReferenceRoot)\Beat Saber_Data\Managed\%(Identity).dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="UnityEngine.VRModule" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\UnityEngine.VRModule.dll" Private="false"
                 Condition="'$(_LegatoPortablePipeline)' == 'BuiltIn' AND '@(Reference->WithMetadataValue('Identity', 'UnityEngine.VRModule'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\UnityEngine.VRModule.dll')" />
      <Reference Include="Unity.RenderPipelines.Core.Runtime.Shared" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Unity.RenderPipelines.Core.Runtime.Shared.dll" Private="false"
                 Condition="'$(_LegatoPortablePipeline)' == 'Universal' AND '@(Reference->WithMetadataValue('Identity', 'Unity.RenderPipelines.Core.Runtime.Shared'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Unity.RenderPipelines.Core.Runtime.Shared.dll')" />
      <Reference Remove="SongDataCore"
                 Condition="'$(LegatoSourceProfile)' == '1.29.0' AND !Exists('$(LegatoReferenceRoot)\Plugins\SongDataCore.dll') AND Exists('$(LegatoLibraryRoot)\SongDetailsCache.dll')" />
      <Reference Include="SongDetailsCache"
                 Condition="'$(LegatoSourceProfile)' == '1.29.0' AND '@(Reference->WithMetadataValue('Identity', 'SongDetailsCache'))' == '' AND !Exists('$(LegatoReferenceRoot)\Plugins\SongDataCore.dll') AND Exists('$(LegatoLibraryRoot)\SongDetailsCache.dll')">
        <HintPath>$(LegatoLibraryRoot)\SongDetailsCache.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Remove="Polyglot"
                 Condition="!Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Polyglot.dll') AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGLib.Polyglot.dll')" />
      <Reference Include="BGLib.Polyglot"
                 Condition="'@(Reference->WithMetadataValue('Identity', 'BGLib.Polyglot'))' == '' AND !Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Polyglot.dll') AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGLib.Polyglot.dll')">
        <HintPath>$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGLib.Polyglot.dll</HintPath>
