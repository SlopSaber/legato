<Project>
  <Import Project="$(MSBuildThisFileDirectory)AssetBundles.targets" />
  <Import Project="$(MSBuildProjectFullPath).user" Condition="'$(LegatoMetadataOnly)' != 'true' AND '$(BeatSaberDir)' == '' AND Exists('$(MSBuildProjectFullPath).user')" />

  <ItemGroup Condition="'$(LegatoEnableObjectDiscovery)' == 'true' OR '$(LegatoEnableUnityCompatibility)' == 'true' OR '$(LegatoEnableLegacyLayoutRepair)' == 'true'">
    <EditorConfigFiles Include="$(LegatoSourceRoot)Library\.editorconfig" />
  </ItemGroup>

  <PropertyGroup>
    <LegatoTargetVersion Condition="'$(LegatoTargetVersion)' == ''">$(LegatoCurrentVersion)</LegatoTargetVersion>
    <LegatoSourceVersion Condition="'$(LegatoSourceVersion)' == '' AND '$(GameVersion)' != ''">$(GameVersion)</LegatoSourceVersion>
    <LegatoSourceVersion Condition="'$(LegatoSourceVersion)' == ''">$(LegatoCurrentVersion)</LegatoSourceVersion>
    <LegatoReferenceRoot Condition="'$(GameReferences)' != ''">$(GameReferences)</LegatoReferenceRoot>
    <LegatoReferenceRoot Condition="'$(LegatoReferenceRoot)' == ''">$(BeatSaberDir)</LegatoReferenceRoot>
    <LegatoLibraryRoot>$(LegatoReferenceRoot)\Libs</LegatoLibraryRoot>
    <LegatoLibraryRoot Condition="Exists('$(LegatoReferenceRoot)\IPA\Data\Managed\IPA.Loader.dll')">$(LegatoReferenceRoot)\Mods\Libraries</LegatoLibraryRoot>
    <LegatoLibraryRoot Condition="Exists('$(LegatoReferenceRoot)\IPA\Pending\Libraries')">$(LegatoReferenceRoot)\IPA\Pending\Libraries</LegatoLibraryRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LegatoAliasBsmlReference)' == 'true'">
    <DefineConstants>$(DefineConstants);LEGATO_BSML_ALIASED</DefineConstants>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)AsyncInterfaces.targets" />
  <Import Project="$(MSBuildThisFileDirectory)ShaffuruProviders.targets" />
  <Import Project="$(MSBuildThisFileDirectory)SiraLocalizerProviders.targets" />
  <Target Name="LegatoConfigure" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <_LegatoTargetVersion Include="@(LegatoGameVersion->WithMetadataValue('Identity', '$(LegatoTargetVersion)'))" />
      <_LegatoSourceVersion Include="@(LegatoGameVersion->WithMetadataValue('Identity', '$(LegatoSourceVersion)'))" />
    </ItemGroup>
    <PropertyGroup>
      <LegatoTargetProfile>@(_LegatoTargetVersion->'%(Profile)')</LegatoTargetProfile>
      <LegatoTargetOrder>@(_LegatoTargetVersion->'%(Order)')</LegatoTargetOrder>
      <LegatoSourceProfile>@(_LegatoSourceVersion->'%(Profile)')</LegatoSourceProfile>
      <LegatoSourceOrder>@(_LegatoSourceVersion->'%(Order)')</LegatoSourceOrder>
      <_LegatoCoreApi>@(_LegatoTargetVersion->'%(CoreApi)')</_LegatoCoreApi>
      <_LegatoPolyfillProfile>$(LegatoTargetProfile)</_LegatoPolyfillProfile>
      <_LegatoPolyfillProfile Condition="'$(LegatoTargetProfile)' == '1.29.4' OR '$(LegatoTargetProfile)' == '1.34.2'">1.29.0</_LegatoPolyfillProfile>
      <_LegatoUsesDifficultyBeatmaps Condition="'$(_LegatoPolyfillProfile)' == '1.29.0' OR '$(_LegatoCoreApi)' == 'LegacyPreview'">true</_LegatoUsesDifficultyBeatmaps>
      <LegatoTargetDefine Condition="'$(LegatoTargetProfile)' != ''">BEAT_SABER_$([System.String]::Copy('$(LegatoTargetProfile)').Replace('.', '_'))</LegatoTargetDefine>
      <DefineConstants Condition="'$(LegatoTargetDefine)' != ''">$(DefineConstants);$(LegatoTargetDefine);@(_LegatoTargetVersion->'%(Constants)')</DefineConstants>
      <DefineConstants Condition="'$(_LegatoUsesDifficultyBeatmaps)' == 'true'">$(DefineConstants);LEGATO_DIFFICULTY_BEATMAPS</DefineConstants>
      <DefineConstants Condition="'$(_LegatoCoreApi)' != ''">$(DefineConstants);LEGATO_HISTORICAL_GAME</DefineConstants>
      <DefineConstants Condition="'$(_LegatoCoreApi)' == 'EarlyAccess' OR '$(LegatoTargetProfile)' == '1.0.0'">$(DefineConstants);LEGATO_AUDIO_WITHOUT_STATE</DefineConstants>
      <DefineConstants Condition="'$(LegatoEnableNativeBeatmapAliases)' == 'true'">$(DefineConstants);LEGATO_NATIVE_BEATMAP_KEYS</DefineConstants>
      <DefineConstants Condition="'$(LegatoEnableSteamAuthentication)' == 'true'">$(DefineConstants);LEGATO_STEAM_WEB_AUTH</DefineConstants>
      <LegatoHasDefaultInterfaceMethods Condition="'$(LegatoTargetProfile)' != '1.29.0' AND '$(LegatoTargetProfile)' != '' AND '$(_LegatoCoreApi)' == ''">true</LegatoHasDefaultInterfaceMethods>
      <DefineConstants Condition="'$(LegatoHasDefaultInterfaceMethods)' == 'true'">$(DefineConstants);LEGATO_DEFAULT_INTERFACE_METHODS</DefineConstants>
      <LegatoUsesNativeRenderTiming>false</LegatoUsesNativeRenderTiming>
      <LegatoUsesNativeRenderTiming Condition="'$(LegatoTargetProfile)' == '1.29.0' OR '$(LegatoTargetProfile)' == '1.45.1' OR '$(LegatoTargetProfile)' == '1.45.3'">true</LegatoUsesNativeRenderTiming>
    </PropertyGroup>
    <Error Condition="'$(LegatoTargetProfile)' == ''" Text="Legato does not support Beat Saber $(LegatoTargetVersion)" />
    <Error Condition="'$(LegatoSourceProfile)' == ''" Text="Legato does not support source written for Beat Saber $(LegatoSourceVersion)" />
    <Error Condition="'$(LegatoEnablePortableRendering)' == 'true' AND '$(LegatoTargetProfile)' != '1.29.0' AND '$(LegatoTargetProfile)' != '1.45.1' AND '$(LegatoTargetProfile)' != '1.45.3'"
           Text="Portable camera passes currently support the built-in 1.29 and Unity 6 profiles only." />
  </Target>

  <Target Name="LegatoPrepareBuildMetadata" BeforeTargets="BeforeBuild;GenerateManifest;GenerateBSMLManifest;BSMT_StartBSIPA;BSMT_GenerateManifest;PrepareForBuild"
          DependsOnTargets="LegatoConfigure" Condition="'$(LegatoMetadataOnly)' == 'true'">
    <PropertyGroup>
      <GameVersion>$(LegatoTargetVersion)</GameVersion>
    </PropertyGroup>
    <Error Condition="'$(GameVersion)' != '$(LegatoTargetVersion)'"
           Text="GameVersion and LegatoTargetVersion must select the same game version." />
    <Message Importance="High" Text="Legato metadata profile: $(LegatoTargetVersion) ($(LegatoTargetProfile))" />
  </Target>

  <Target Name="LegatoAddRequiredReferences" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="LegatoConfigure"
          Condition="'$(LegatoMetadataOnly)' != 'true' AND '$(LegatoEnableReferenceShims)' != 'false'">
    <ItemGroup>
      <Reference Include="Colors" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Colors.dll" Private="false"
                 Condition="'$(LegatoEnableBeatmapKeys)' == 'true' AND '@(Reference->WithMetadataValue('Identity', 'Colors'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Colors.dll')" />
      <Reference Include="BGNet" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGNet.dll" Private="false"
                 Condition="'$(LegatoEnablePlatformAuthentication)' == 'true' AND '$(LegatoTargetProfile)' == '1.29.0' AND '@(Reference->WithMetadataValue('Identity', 'BGNet'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGNet.dll')" />
      <Reference Include="Unity.RenderPipelines.Core.Runtime;Unity.RenderPipelines.Universal.Runtime"
                 Condition="('$(LegatoEnableCameraEffects)' == 'true' OR '$(LegatoEnablePortableRendering)' == 'true') AND ('$(LegatoTargetProfile)' == '1.45.1' OR '$(LegatoTargetProfile)' == '1.45.3')">
        <HintPath>$(LegatoReferenceRoot)\Beat Saber_Data\Managed\%(Identity).dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="UnityEngine.VRModule" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\UnityEngine.VRModule.dll" Private="false"
                 Condition="'$(LegatoEnablePortableRendering)' == 'true' AND '$(LegatoTargetProfile)' == '1.29.0' AND '@(Reference->WithMetadataValue('Identity', 'UnityEngine.VRModule'))' == ''" />
      <Reference Include="Unity.RenderPipelines.Core.Runtime.Shared" HintPath="$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Unity.RenderPipelines.Core.Runtime.Shared.dll" Private="false"
                 Condition="'$(LegatoEnablePortableRendering)' == 'true' AND ('$(LegatoTargetProfile)' == '1.45.1' OR '$(LegatoTargetProfile)' == '1.45.3') AND '@(Reference->WithMetadataValue('Identity', 'Unity.RenderPipelines.Core.Runtime.Shared'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Unity.RenderPipelines.Core.Runtime.Shared.dll')" />
      <Reference Remove="SongDataCore"
                 Condition="'$(LegatoSourceProfile)' == '1.29.0' AND !Exists('$(LegatoReferenceRoot)\Plugins\SongDataCore.dll') AND Exists('$(LegatoLibraryRoot)\SongDetailsCache.dll')" />
      <Reference Include="SongDetailsCache"
                 Condition="'$(LegatoSourceProfile)' == '1.29.0' AND '@(Reference->WithMetadataValue('Identity', 'SongDetailsCache'))' == '' AND !Exists('$(LegatoReferenceRoot)\Plugins\SongDataCore.dll') AND Exists('$(LegatoLibraryRoot)\SongDetailsCache.dll')">
        <HintPath>$(LegatoLibraryRoot)\SongDetailsCache.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Remove="Polyglot"
                 Condition="!Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Polyglot.dll') AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGLib.Polyglot.dll')" />
      <Reference Include="BGLib.Polyglot"
                 Condition="'@(Reference->WithMetadataValue('Identity', 'BGLib.Polyglot'))' == '' AND !Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Polyglot.dll') AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGLib.Polyglot.dll')">
        <HintPath>$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGLib.Polyglot.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="DataModels" Condition="'@(Reference->WithMetadataValue('Identity', 'DataModels'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\DataModels.dll')">
        <HintPath>$(LegatoReferenceRoot)\Beat Saber_Data\Managed\DataModels.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="AdditionalContentModel.Interfaces" Condition="'@(Reference->WithMetadataValue('Identity', 'AdditionalContentModel.Interfaces'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\AdditionalContentModel.Interfaces.dll')">
        <HintPath>$(LegatoReferenceRoot)\Beat Saber_Data\Managed\AdditionalContentModel.Interfaces.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="BGLib.AppFlow" Condition="'@(Reference->WithMetadataValue('Identity', 'BGLib.AppFlow'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGLib.AppFlow.dll')">
        <HintPath>$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGLib.AppFlow.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="BGLib.UnityExtension" Condition="'@(Reference->WithMetadataValue('Identity', 'BGLib.UnityExtension'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGLib.UnityExtension.dll')">
        <HintPath>$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BGLib.UnityExtension.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Colors" Condition="'@(Reference->WithMetadataValue('Identity', 'Colors'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Colors.dll')">
        <HintPath>$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Colors.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="GameplayCore" Condition="'@(Reference->WithMetadataValue('Identity', 'GameplayCore'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\GameplayCore.dll')">
        <HintPath>$(LegatoReferenceRoot)\Beat Saber_Data\Managed\GameplayCore.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="BeatSaber.ViewSystem" Condition="'@(Reference->WithMetadataValue('Identity', 'BeatSaber.ViewSystem'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BeatSaber.ViewSystem.dll')">
        <HintPath>$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BeatSaber.ViewSystem.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="SegmentedControl" Condition="'@(Reference->WithMetadataValue('Identity', 'SegmentedControl'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\SegmentedControl.dll')">
        <HintPath>$(LegatoReferenceRoot)\Beat Saber_Data\Managed\SegmentedControl.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="UnityEngine.UnityWebRequestModule" Condition="'@(Reference->WithMetadataValue('Identity', 'UnityEngine.UnityWebRequestModule'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\UnityEngine.UnityWebRequestModule.dll')">
        <HintPath>$(LegatoReferenceRoot)\Beat Saber_Data\Managed\UnityEngine.UnityWebRequestModule.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="BeatmapCore" Condition="('$(LegatoEnableNativeBeatmapAliases)' == 'true' OR '$(LegatoTargetProfile)' == '1.45.1' OR '$(LegatoTargetProfile)' == '1.45.3') AND '@(Reference->WithMetadataValue('Identity', 'BeatmapCore'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BeatmapCore.dll')">
        <HintPath>$(LegatoReferenceRoot)\Beat Saber_Data\Managed\BeatmapCore.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Unity.TextMeshPro" Condition="('$(LegatoTargetProfile)' == '1.45.1' OR '$(LegatoTargetProfile)' == '1.45.3') AND '@(Reference->WithMetadataValue('Identity', 'Unity.TextMeshPro'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Unity.TextMeshPro.dll')">
        <HintPath>$(LegatoReferenceRoot)\Beat Saber_Data\Managed\Unity.TextMeshPro.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="netstandard" Condition="('$(LegatoTargetProfile)' == '1.45.1' OR '$(LegatoTargetProfile)' == '1.45.3') AND '@(Reference->WithMetadataValue('Identity', 'netstandard'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\netstandard.dll')">
        <HintPath>$(LegatoReferenceRoot)\Beat Saber_Data\Managed\netstandard.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="UnityEngine.ImageConversionModule" Condition="('$(LegatoTargetProfile)' == '1.45.1' OR '$(LegatoTargetProfile)' == '1.45.3') AND '@(Reference->WithMetadataValue('Identity', 'UnityEngine.ImageConversionModule'))' == '' AND Exists('$(LegatoReferenceRoot)\Beat Saber_Data\Managed\UnityEngine.ImageConversionModule.dll')">
        <HintPath>$(LegatoReferenceRoot)\Beat Saber_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>

  <Target Name="LegatoBridgeReferencePublicizeMetadata" BeforeTargets="Publicize"
          Condition="'$(LegatoMetadataOnly)' != 'true' AND '$(LegatoUseReferencePublicizeMetadata)' == 'true'">
    <ItemGroup>
      <_LegatoPublicizeReference Include="@(Reference->WithMetadataValue('Publicize', 'true'))" />
      <Publicize Include="@(_LegatoPublicizeReference)" PublicizeTarget="All"
                 PublicizeCompilerGenerated="false" IncludeOriginalAttributesAttribute="false" Strip="false" />
    </ItemGroup>
  </Target>

  <Target Name="LegatoLoaderJsonReference" BeforeTargets="ResolveAssemblyReferences"
          DependsOnTargets="LegatoConfigure;BSIPA_ResolveLayoutReferences"
          Condition="'$(LegatoUseLoaderJson)' == 'true'">
    <ItemGroup>
      <Reference Update="@(Reference)" Condition="'%(Reference.Identity)' == 'Newtonsoft.Json' AND Exists('$(LegatoReferenceRoot)\IPA\CoreLibraries\Newtonsoft.Json.dll')">
        <HintPath>$(LegatoReferenceRoot)\IPA\CoreLibraries\Newtonsoft.Json.dll</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>

  <Target Name="LegatoPrepareManifest" BeforeTargets="BSMT_StartBSIPA;PrepareForBuild"
          DependsOnTargets="LegatoConfigure" Condition="'$(LegatoManifestFile)' != ''">
    <PropertyGroup>
      <_LegatoManifestInput>$(MSBuildProjectDirectory)\$(LegatoManifestFile)</_LegatoManifestInput>
      <_LegatoManifestOutput>$(IntermediateOutputPath)Legato\$(LegatoTargetVersion)\manifest.json</_LegatoManifestOutput>
      <_LegatoManifestResourceName Condition="'$(LegatoManifestResourceName)' == ''">$(RootNamespace).manifest.json</_LegatoManifestResourceName>
      <_LegatoManifestResourceName Condition="'$(LegatoManifestResourceName)' != ''">$(LegatoManifestResourceName)</_LegatoManifestResourceName>
      <_LegatoManifestText>$([System.IO.File]::ReadAllText('$(_LegatoManifestInput)'))</_LegatoManifestText>
      <_LegatoManifestText>$([System.Text.RegularExpressions.Regex]::Replace('$(_LegatoManifestText)', '&quot;gameVersion&quot;\s*:\s*&quot;[^&quot;]+&quot;', '&quot;gameVersion&quot;: &quot;$(LegatoTargetVersion)&quot;'))</_LegatoManifestText>
      <ManifestPath>$(_LegatoManifestOutput)</ManifestPath>
    </PropertyGroup>
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_LegatoManifestOutput)'))" />
    <WriteLinesToFile File="$(_LegatoManifestOutput)" Lines="$(_LegatoManifestText)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <ItemGroup>
      <EmbeddedResource Remove="$(LegatoManifestFile);$(_LegatoManifestInput)" />
      <EmbeddedResource Include="$(_LegatoManifestOutput)" LogicalName="$(_LegatoManifestResourceName)"
                        Condition="'$(LegatoEmbedManifest)' != 'false'" />
    </ItemGroup>
  </Target>

  <Target Name="LegatoCopyManifestSidecar" AfterTargets="Build"
          Condition="'$(LegatoManifestSidecar)' == 'true' AND '$(LegatoManifestFile)' != ''">
    <Copy SourceFiles="$(_LegatoManifestOutput)" DestinationFiles="$(TargetDir)$(AssemblyName).manifest"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="LegatoAddBaseSources" BeforeTargets="CoreCompile" DependsOnTargets="LegatoConfigure"
          Condition="'$(LegatoMetadataOnly)' != 'true'">
    <ItemGroup Condition="'$(LegatoEnablePolyfills)' != 'false' AND '$(_LegatoCoreApi)' != ''">
      <Compile Include="$(LegatoSourceRoot)GlobalUsings.cs;$(LegatoSourceRoot)Polyfills\System\**\*.cs;$(LegatoSourceRoot)Polyfills\UnityEngine\Networking\UnityWebRequest\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\AudioTimeSyncController\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\System\Collections\Concurrent\**\*.cs" Condition="'$(LegatoTargetProfile)' == '0.10.1'" />
      <Compile Condition="'$(_LegatoCoreApi)' == 'LegacyPreview'"
               Include="$(LegatoSourceRoot)Polyfills\GlobalNamespace\AudioManager\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\BeatmapKey\Versions\1.29.0\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\BeatmapLevel\Versions\1.29.0\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\IPreviewMediaData\Versions\1.29.0\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\StandardLevelScenesTransitionSetupData\*.cs" />
      <Compile Include="$(LegatoSourceRoot)Polyfills\GlobalNamespace\GameplayCoreSceneSetupData\Transitions\1.29.0-1.37.1\*.cs"
               Condition="'$(_LegatoCoreApi)' == 'LegacyPreview'" />
      <Compile Include="$(LegatoSourceRoot)Polyfills\GlobalNamespace\LevelSelectionNavigationController\LevelSelectionNavigationControllerExtensions.cs"
               Condition="'$(LegatoTargetProfile)' == '1.11.1' OR '$(LegatoTargetProfile)' == '1.12.1'" />
    </ItemGroup>
    <ItemGroup Condition="'$(LegatoEnablePolyfills)' != 'false' AND '$(_LegatoCoreApi)' == ''">
      <Compile Include="$(LegatoSourceRoot)GlobalUsings.cs;$(LegatoSourceRoot)Library\Platform\Authentication\**\*.cs;$(LegatoSourceRoot)Library\Platform\Friends\**\*.cs;$(LegatoSourceRoot)Library\XR\Headset\**\*.cs;$(LegatoSourceRoot)Library\XR\InputFocus\**\*.cs" />
      <Compile Include="$(LegatoSourceRoot)Polyfills\**\*.cs" Exclude="$(LegatoSourceRoot)Polyfills\System\**\*.cs" />
      <Compile Include="$(LegatoSourceRoot)Polyfills\System\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)**\Versions\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)ForwardPolyfills\**\*.cs" />
      <Compile Include="$(LegatoSourceRoot)Polyfills\**\Versions\$(_LegatoPolyfillProfile)\**\*.cs" Condition="'$(_LegatoPolyfillProfile)' != ''" />
      <Compile Include="$(LegatoSourceRoot)Polyfills\**\Versions\1.29.0-1.37.1\**\*.cs" Condition="'$(_LegatoPolyfillProfile)' == '1.29.0' OR '$(LegatoTargetProfile)' == '1.37.1'" />
      <Compile Include="$(LegatoSourceRoot)Polyfills\**\Versions\1.29.0-1.38.0\**\*.cs" Condition="'$(_LegatoPolyfillProfile)' == '1.29.0' OR '$(LegatoTargetProfile)' == '1.37.1' OR '$(LegatoTargetProfile)' == '1.38.0'" />
      <Compile Include="$(LegatoSourceRoot)Polyfills\**\Versions\1.29.0-1.40.0\**\*.cs" Condition="'$(_LegatoPolyfillProfile)' == '1.29.0' OR '$(LegatoTargetProfile)' == '1.37.1' OR '$(LegatoTargetProfile)' == '1.38.0' OR '$(LegatoTargetProfile)' == '1.40.0'" />
      <Compile Include="$(LegatoSourceRoot)Polyfills\**\Versions\1.37.1-1.40.0\**\*.cs" Condition="'$(LegatoTargetProfile)' == '1.37.1' OR '$(LegatoTargetProfile)' == '1.38.0' OR '$(LegatoTargetProfile)' == '1.40.0'" />
      <Compile Include="$(LegatoSourceRoot)ForwardPolyfills\**\Transitions\1.29.0-1.37.1\**\*.cs" Condition="'$(LegatoSourceOrder)' != '' AND '$(LegatoTargetOrder)' != '' AND $(LegatoSourceOrder) &lt;= 0.5 AND $(LegatoTargetOrder) &gt;= 1" />
      <Compile Remove="$(LegatoSourceRoot)Library\Presentation\**\*.cs;$(LegatoSourceRoot)Library\Resources\**\*.cs;$(LegatoSourceRoot)Polyfills\BeatSaberMarkupLanguage\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\UnityEngine\UI\Image\Versions\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\LeaderboardCore\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\SongCore\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\SongDataCore\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\TMPro\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\BS_Utils\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\SiraUtil\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\GlobalNamespace\BeatmapKey\BeatmapKeyExtensions.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\GlobalNamespace\BeatmapLevelPack\**\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\LevelCollectionNavigationController\BeatmapLevelPackAdapterExtensions.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\LevelCollectionViewController\BeatmapLevelPackAdapterExtensions.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\LevelCollectionViewController\BeatmapLevelSelectionSubscription.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\LevelFilteringNavigationController\**\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\LevelSelectionNavigationController\LevelSelectionSession.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\StandardLevelDetailViewController\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Library\Beatmaps\**\*.cs" />
      <Compile Remove="$(LegatoSourceRoot)Library\Gameplay\GameplayMetadataProvider.cs;$(LegatoSourceRoot)Library\Platform\**\*.cs;$(LegatoSourceRoot)Library\Rooms\**\*.cs;$(LegatoSourceRoot)Library\XR\XrDeviceDiscovery.cs" />
      <Compile Remove="$(LegatoSourceRoot)Polyfills\GlobalNamespace\MainCamera\**\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\OculusVRHelper\**\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\PauseController\**\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\UnityXRHelper\**\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\UnityXRSystemState\**\*.cs;$(LegatoSourceRoot)Polyfills\GlobalNamespace\VariableMovementDataProvider\**\*.cs" />
    </ItemGroup>
  </Target>

  <Target Name="LegatoAddOptionalSources" BeforeTargets="CoreCompile" DependsOnTargets="LegatoAddBaseSources;ResolveReferences"
          Condition="'$(LegatoMetadataOnly)' != 'true'">
    <ItemGroup>
      <_LegatoBSMLReference Include="@(ReferencePath->WithMetadataValue('Filename', 'BSML'))" />
      <_LegatoTextMeshProReference Include="@(ReferencePath->WithMetadataValue('Filename', 'Unity.TextMeshPro'))" />
      <_LegatoLeaderboardCoreReference Include="@(ReferencePath->WithMetadataValue('Filename', 'LeaderboardCore'))" />
      <_LegatoSiraUtilReference Include="@(ReferencePath->WithMetadataValue('Filename', 'SiraUtil'))" />
      <_LegatoSongCoreReference Include="@(ReferencePath->WithMetadataValue('Filename', 'SongCore'))" />
      <_LegatoSongDataCoreReference Include="@(ReferencePath->WithMetadataValue('Filename', 'SongDataCore'))" />
      <_LegatoSongDetailsReference Include="@(ReferencePath->WithMetadataValue('Filename', 'SongDetailsCache'))" />
      <_LegatoBSUtilsReference Include="@(ReferencePath->WithMetadataValue('Filename', 'BS_Utils'))" />
      <_LegatoIPAReference Include="@(ReferencePath->WithMetadataValue('Filename', 'IPA.Loader'))" />
      <_LegatoGameSettingsReference Include="@(ReferencePath->WithMetadataValue('Filename', 'BeatSaber.GameSettings'))" />
      <_LegatoPlatformUserModelReference Include="@(ReferencePath->WithMetadataValue('Filename', 'PlatformUserModel'))" />
      <_LegatoOculusPlatformReference Include="@(ReferencePath->WithMetadataValue('Filename', 'Oculus.Platform'))" />
      <_LegatoPlatformCoreReference Include="@(ReferencePath->WithMetadataValue('Filename', 'OculusStudios.Platform.Core'))" />
      <_LegatoSteamReference Include="@(ReferencePath->WithMetadataValue('Filename', 'com.rlabrecque.steamworks.net'))" />
      <_LegatoHarmonyReference Include="@(ReferencePath->WithMetadataValue('Filename', '0Harmony'))" />
      <_LegatoHttpReference Include="@(ReferencePath->WithMetadataValue('Filename', 'System.Net.Http'))" />
      <_LegatoSpatialTrackingReference Include="@(ReferencePath->WithMetadataValue('Filename', 'UnityEngine.SpatialTracking'))" />
      <_LegatoXRReference Include="@(ReferencePath->WithMetadataValue('Filename', 'UnityEngine.XRModule'))" />
      <_LegatoOpenXRReference Include="@(ReferencePath->WithMetadataValue('Filename', 'Unity.XR.OpenXR'))" />
      <_LegatoMainReference Include="@(ReferencePath->WithMetadataValue('Filename', 'Main'))" />
      <_LegatoDataModelsReference Include="@(ReferencePath->WithMetadataValue('Filename', 'DataModels'))" />
      <_LegatoAudioReference Include="@(ReferencePath->WithMetadataValue('Filename', 'BeatSaber.Audio.Common'))" />
      <_LegatoColorsReference Include="@(ReferencePath->WithMetadataValue('Filename', 'Colors'))" />
      <_LegatoGameplayCoreReference Include="@(ReferencePath->WithMetadataValue('Filename', 'GameplayCore'))" />
      <_LegatoUnityReference Include="@(ReferencePath->WithMetadataValue('Filename', 'UnityEngine.CoreModule'))" />
      <_LegatoZenjectReference Include="@(ReferencePath->WithMetadataValue('Filename', 'Zenject'))" />
      <_LegatoHMLibReference Include="@(ReferencePath->WithMetadataValue('Filename', 'HMLib'))" />
    </ItemGroup>
    <GetAssemblyIdentity AssemblyFiles="@(_LegatoBSMLReference)" Condition="'@(_LegatoBSMLReference)' != ''">
      <Output TaskParameter="Assemblies" ItemName="_LegatoBsmlIdentity" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <_LegatoBsmlApiVersion>@(_LegatoBsmlIdentity->'%(Version)')</_LegatoBsmlApiVersion>
      <DefineConstants Condition="'$(_LegatoBsmlApiVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_LegatoBsmlApiVersion)', '1.14.0.0'))">$(DefineConstants);LEGATO_BSML_CURRENT</DefineConstants>
