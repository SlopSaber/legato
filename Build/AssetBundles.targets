<Project>
  <Target Name="LegatoBuildAssetBundles" DependsOnTargets="LegatoConfigure">
    <PropertyGroup>
      <LegatoUnityEditorRoot Condition="'$(LegatoUnityEditorRoot)' == ''">$(UNITY_EDITOR_ROOT)</LegatoUnityEditorRoot>
    </PropertyGroup>
    <ItemGroup>
      <_LegatoAssetProject Include="@(LegatoAssetProject)" Condition="'%(LegatoAssetProject.Profile)' == '$(LegatoTargetProfile)' OR '%(LegatoAssetProject.Profile)' == ''">
        <SelectedUnityVersion Condition="'%(LegatoAssetProject.UnityVersion)' != ''">%(LegatoAssetProject.UnityVersion)</SelectedUnityVersion>
        <SelectedUnityVersion Condition="'%(LegatoAssetProject.UnityVersion)' == ''">$(LegatoAssetUnityVersion)</SelectedUnityVersion>
      </_LegatoAssetProject>
    </ItemGroup>
    <Error Condition="'@(_LegatoAssetProject)' == ''" Text="No source asset project is configured for this Legato profile." />
    <Error Condition="'$(LegatoUnityEditorRoot)' == ''" Text="Set LegatoUnityEditorRoot or UNITY_EDITOR_ROOT to the directory containing versioned Unity editors." />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildThisFileDirectory)Build-AssetBundle.ps1&quot; -ProjectPath &quot;%(_LegatoAssetProject.FullPath)&quot; -TargetVersion &quot;$(LegatoTargetVersion)&quot; -UnityVersion &quot;%(_LegatoAssetProject.SelectedUnityVersion)&quot; -UnityEditorRoot &quot;$(LegatoUnityEditorRoot)&quot; -ExecuteMethod &quot;%(_LegatoAssetProject.ExecuteMethod)&quot; -OutputFile &quot;%(_LegatoAssetProject.OutputFile)&quot; -LogPath &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)LegatoAssets/$(LegatoTargetVersion)/%(_LegatoAssetProject.Filename).log&quot;" />
  </Target>
  <Target Name="LegatoBuildAssetsBeforeEmbedding" BeforeTargets="AssignTargetPaths" DependsOnTargets="LegatoBuildAssetBundles" Condition="'$(LegatoBuildAssets)' == 'true'" />
</Project>
