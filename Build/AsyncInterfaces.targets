<Project>
  <ItemGroup Condition="'$(LegatoEnableAsyncInterfaces)' == 'true'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="11.0.0" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="LegatoConfigureAsyncFramework" BeforeTargets="GetReferenceAssemblyPaths" Condition="'$(LegatoEnableAsyncInterfaces)' == 'true'">
    <PropertyGroup>
      <EnableFrameworkPathOverride>true</EnableFrameworkPathOverride>
      <FrameworkPathOverride>$(NuGetPackageRoot)microsoft.netframework.referenceassemblies.net472\1.0.3\build\.NETFramework\v4.7.2</FrameworkPathOverride>
    </PropertyGroup>
  </Target>
  <Target Name="LegatoResolveAsyncFramework" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="$(LegatoAsyncLayoutTarget)" Condition="'$(LegatoEnableAsyncInterfaces)' == 'true'">
    <ItemGroup>
      <Reference Remove="mscorlib;netstandard" />
      <Reference Include="mscorlib" HintPath="$(NuGetPackageRoot)microsoft.netframework.referenceassemblies.net472\1.0.3\build\.NETFramework\v4.7.2\mscorlib.dll" Private="false" />
      <Reference Include="netstandard" HintPath="$(NuGetPackageRoot)microsoft.netframework.referenceassemblies.net472\1.0.3\build\.NETFramework\v4.7.2\Facades\netstandard.dll" Private="false" />
    </ItemGroup>
  </Target>
  <Target Name="LegatoCopyAsyncRuntime" AfterTargets="Build" Condition="'$(LegatoEnableAsyncInterfaces)' == 'true'">
    <ItemGroup>
      <_LegatoAsyncRuntime Include="$(NuGetPackageRoot)microsoft.bcl.asyncinterfaces\11.0.0\lib\net462\Microsoft.Bcl.AsyncInterfaces.dll;$(NuGetPackageRoot)system.threading.tasks.extensions\4.6.3\lib\net462\System.Threading.Tasks.Extensions.dll;$(NuGetPackageRoot)system.runtime.compilerservices.unsafe\6.1.2\lib\net462\System.Runtime.CompilerServices.Unsafe.dll" />
    </ItemGroup>
    <MakeDir Directories="$(ArtifactDir)$(PluginFolderName)\Libraries" />
    <Copy SourceFiles="@(_LegatoAsyncRuntime)" DestinationFolder="$(ArtifactDir)$(PluginFolderName)\Libraries" />
  </Target>
</Project>
