<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsPackable>true</IsPackable>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <PackageId>LegatoBS</PackageId>
    <Version>$(LegatoVersion)</Version>
    <Title>Legato</Title>
    <Authors>ScoreSaber</Authors>
    <Description>Source compatibility helpers for Beat Saber PC mods</Description>
    <PackageTags>beat-saber;modding;compatibility;polyfill</PackageTags>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/ScoreSaber/legato</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ScoreSaber/legato.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LIBRARY.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
    <None Include="ThirdParty\**\*" Pack="true" PackagePath="ThirdParty\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="Build\Legato.props" Pack="true" PackagePath="build\LegatoBS.props" />
    <None Include="Build\Legato.Versions.props" Pack="true" PackagePath="build\Legato.Versions.props" />
    <None Include="Build\BsUtilsHost.targets" Pack="true" PackagePath="build\BsUtilsHost.targets" />
    <None Include="Resources\**\*" Pack="true" PackagePath="build\Resources\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="Build\ShaffuruProviders.targets" Pack="true" PackagePath="build\ShaffuruProviders.targets" />
    <None Include="Build\BetterSongListProviders.targets" Pack="true" PackagePath="build\BetterSongListProviders.targets" />
    <None Include="Build\Tweaks55Providers.targets" Pack="true" PackagePath="build\Tweaks55Providers.targets" />
    <None Include="Build\MappingExtensionsProviders.targets" Pack="true" PackagePath="build\MappingExtensionsProviders.targets" />
    <None Include="Build\ChatPlexProviders.targets" Pack="true" PackagePath="build\ChatPlexProviders.targets" />
    <None Include="Build\KeepOverrides.targets" Pack="true" PackagePath="build\KeepOverrides.targets" />
    <None Include="Build\SongCoreProviders.targets" Pack="true" PackagePath="build\SongCoreProviders.targets" />
    <None Include="Build\SynapseProviders.targets" Pack="true" PackagePath="build\SynapseProviders.targets" />
    <None Include="Build\ReactiveHost.targets" Pack="true" PackagePath="build\ReactiveHost.targets" />
    <None Include="Build\NativeTypeAliases.targets" Pack="true" PackagePath="build\NativeTypeAliases.targets" />
    <None Include="Build\SiraHost.targets" Pack="true" PackagePath="build\SiraHost.targets" />
    <None Include="Build\BsmlHost.targets" Pack="true" PackagePath="build\BsmlHost.targets" />
    <None Include="Build\HitbloqProviders.targets" Pack="true" PackagePath="build\HitbloqProviders.targets" />
    <None Include="Build\HeckProviders.targets" Pack="true" PackagePath="build\HeckProviders.targets" />
    <None Include="Build\Legato.targets" Pack="true" PackagePath="build\LegatoBS.targets" />
    <None Include="Source\**\.editorconfig" Pack="true" PackagePath="build\Source\%(RecursiveDir).editorconfig" />
    <None Include="Source\**\*.cs" Pack="true" PackagePath="build\Source\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
